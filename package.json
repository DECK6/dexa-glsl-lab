{
  "name": "dexa-glsl-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run lint:registry && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test tests/catalog.test.ts tests/runtime-contract.test.ts",
    "lint:registry": "bun scripts/lint-registry.mjs",
    "lint:registry:partial": "bun scripts/lint-registry.mjs --allow-incomplete",
    "audit:shaders": "bun scripts/audit-runtime.mjs",
    "audit:core": "bun scripts/audit-shaders.mjs --core-only",
    "audit:contacts": "bun scripts/contact-sheets.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "test:e2e": "playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
