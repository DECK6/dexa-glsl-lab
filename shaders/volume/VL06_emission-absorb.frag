float vl06Field(vec2 p,float t){float trans=1.,light=0.;for(int k=0;k<30;k++){float z=float(k)/29.*2.-1.;float density=exp(-2.5*dot(vec3(p,z),vec3(p,z)))*(.65+.35*sin(z*8.+p.x*4.+t));float emit=density*exp(-14.*pow(z-.2,2.));light+=trans*emit*.12;trans*=1.-density*.055;}return light+(.2*(1.-trans));}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 vl06p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.3;float vl06e=.008;float vl06v=vl06Field(vl06p,iTime);vec2 vl06g=vec2(vl06Field(vl06p+vec2(vl06e,0.),iTime)-vl06v,vl06Field(vl06p+vec2(0.,vl06e),iTime)-vl06v)/vl06e;vec3 vl06normal=normalize(vec3(-vl06g,1.));float vl06lit=.5+.5*dot(vl06normal,normalize(vec3(.7,.5,1.)));vec3 vl06c=mix(uColInk,uColPaper,vl06lit);vl06c=mix(vl06c,uColSignal,smoothstep(.12,.01,abs(vl06v)));vl06c=mix(uColBg,vl06c,smoothstep(.02,.35,length(vl06g)));fragColor=vec4(vl06c,1.);}
