float ty03Seg(vec2 p,vec2 a,vec2 b){vec2 q=p-a,d=b-a;return length(q-d*clamp(dot(q,d)/dot(d,d),0.,1.));} float ty03Field(vec2 p,float t){float d=min(ty03Seg(p,vec2(-.7,-.8),vec2(-.2,.8)),ty03Seg(p,vec2(-.2,.8),vec2(.25,-.8)));d=min(d,ty03Seg(p,vec2(-.5,0.),vec2(.05,0.)));d=min(d,ty03Seg(p,vec2(.45,-.8),vec2(.45,.8)));return d+.04*sin(t+p.y*4.);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 ty03p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.2;float ty03a=ty03Field(ty03p,iTime);float ty03b=ty03Field(mat2(.8,-.6,.6,.8)*ty03p*1.17,-iTime*.73);float ty03cross=smoothstep(.18,.01,abs(ty03a-ty03b));vec3 ty03col=mix(uColInk,uColPaper,.5+.5*sin(ty03a*5.));ty03col=mix(ty03col,uColSignal,ty03cross);ty03col=mix(uColBg,ty03col,smoothstep(.02,.75,abs(ty03a)+abs(ty03b)));fragColor=vec4(ty03col,1.);}
