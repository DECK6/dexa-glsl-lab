float ty01Box(vec2 p,vec2 b){return max(abs(p.x)-b.x,abs(p.y)-b.y);} float ty01Field(vec2 p,float t){float n=mod(floor(t),10.);float h=min(ty01Box(p-vec2(0,.65),vec2(.45,.07)),ty01Box(p-vec2(0,0.),vec2(.45,.07)));h=min(h,ty01Box(p+vec2(0,.65),vec2(.45,.07)));float v=min(ty01Box(p-vec2(-.48,.33),vec2(.07,.3)),ty01Box(p-vec2(.48,.33),vec2(.07,.3)));v=min(v,min(ty01Box(p-vec2(-.48,-.33),vec2(.07,.3)),ty01Box(p-vec2(.48,-.33),vec2(.07,.3))));return min(h,v)+.02*sin(n+p.x);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.4;float d=ty01Field(p,iTime);float seg=smoothstep(.09,.005,-d);float scan=pow(.5+.5*cos(p.y*5.-iTime*3.2),10.);float ghost=smoothstep(.12,.02,abs(d));vec3 col=mix(uColBg,uColDim,.16+.2*ghost);col=mix(col,uColPaper,seg*.72);col+=uColSignal*seg*(.2+.8*scan)+uColAccent*ghost*scan*.28;fragColor=vec4(col,1.);}
