float vs04Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;float gx=vs04Luma(texture(iChannel0,uv+vec2(px.x,0)).rgb-texture(iChannel0,uv-vec2(px.x,0)).rgb);float gy=vs04Luma(texture(iChannel0,uv+vec2(0,px.y)).rgb-texture(iChannel0,uv-vec2(0,px.y)).rgb);float response=smoothstep(.025,.18,abs(gx*gy));vec2 cell=fract(uv*vec2(7.,5.))-.5;float cross=smoothstep(.06,.015,min(abs(cell.x),abs(cell.y)))*step(length(cell),.25);float pulse=.55+.45*sin(iTime*2.+floor(uv.x*7.)+floor(uv.y*5.));vec3 col=mix(uColBg,uColDim,vs04Luma(src)*.34);col+=uColSignal*response*.72+uColPaper*cross*response;col+=uColAccent*cross*(.16+.44*pulse);fragColor=vec4(col,1.);}
