float vs02Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float l=vs02Luma(src);base=mix(uColInk,uColSignal,smoothstep(.12,.62,l));base=mix(base,uColAccent,smoothstep(.62,.9,l));feature=smoothstep(.45,.55,fract(l*5.+iTime*.08));float lum=vs02Luma(base);float scan=pow(.5+.5*cos((uv.x*24.0+uv.y*8.0-iTime*1.2)),12.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
