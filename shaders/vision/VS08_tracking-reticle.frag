float vs08Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec3 src=texture(iChannel0,uv).rgb;vec2 target=vec2(.5)+.18*vec2(sin(iTime*.6),cos(iTime*.47));vec2 d=abs(uv-target);float box=smoothstep(.012,.002,abs(max(d.x,d.y)-.16));float ring=smoothstep(.009,.002,abs(length(d)-.045));float cross=(smoothstep(.008,.001,d.x)+smoothstep(.008,.001,d.y))*step(length(d),.23);float sweep=pow(.5+.5*cos(atan(d.y,d.x)-iTime*2.),18.)*step(length(d),.19);float lum=vs08Luma(src);vec3 col=mix(uColBg,uColDim,lum*.28);col+=uColSignal*(box+cross*.45)+uColPaper*ring;col+=uColAccent*sweep*.62;fragColor=vec4(col,1.);}
