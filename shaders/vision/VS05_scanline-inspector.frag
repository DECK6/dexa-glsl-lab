float vs05Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float row=.5+.28*sin(iTime*.35);float line=step(abs(uv.y-row),.006);float l=vs05Luma(texture(iChannel0,vec2(uv.x,row)).rgb);float graph=step(abs(uv.y-(.12+.28*l)),.008);feature=max(line,graph);base=src*(.65+.35*line);float lum=vs05Luma(base);float scan=pow(.5+.5*cos((uv.x*30.0+uv.y*11.0-iTime*1.2)),12.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
