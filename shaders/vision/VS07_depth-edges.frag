float vs07Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float d=vs07Luma(src);float dx=abs(d-vs07Luma(texture(iChannel0,uv+vec2(px.x*2.,0)).rgb));float dy=abs(d-vs07Luma(texture(iChannel0,uv+vec2(0,px.y*2.)).rgb));feature=smoothstep(.02,.18,dx+dy);base=mix(src,vec3(fract(d*7.+iTime*.04)),.32);float lum=vs07Luma(base);float scan=pow(.5+.5*cos((uv.x*34.0+uv.y*13.0-iTime*1.2)),12.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
