float vs10Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec2 drift=vec2(sin(iTime*.7),cos(iTime*.53))*px*6.;vec3 delayed=texture(iChannel0,uv-drift).rgb;feature=smoothstep(.04,.3,length(src-delayed));base=mix(src,delayed,.45);float lum=vs10Luma(base);float scan=pow(.5+.5*cos((uv.x*40.0+uv.y*16.0-iTime*1.2)),12.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
