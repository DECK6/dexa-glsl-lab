float vs09Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec3 mean=(texture(iChannel0,uv+vec2(px.x*3.,0)).rgb+texture(iChannel0,uv-vec2(px.x*3.,0)).rgb+texture(iChannel0,uv+vec2(0,px.y*3.)).rgb+texture(iChannel0,uv-vec2(0,px.y*3.)).rgb)*.25;float delta=vs09Luma(src-mean);feature=abs(delta)*4.;base=.5+(src-mean)*(2.+sin(iTime*.4));float lum=vs09Luma(base);float scan=pow(.5+.5*cos((uv.x*38.0+uv.y*15.0-iTime*1.2)),12.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
