float mc06Seg(vec2 p,vec2 a,vec2 b){vec2 q=p-a,d=b-a;return length(q-d*clamp(dot(q,d)/dot(d,d),0.,1.));} float mc06Field(vec2 p,float t){vec2 pin=.42*vec2(cos(t),sin(t));float x=pin.x+sqrt(max(.01,1.-pin.y*pin.y));vec2 piston=vec2(x,0.);float rod=mc06Seg(p,pin,piston);float body=max(abs(p.x-x)-.18,abs(p.y)-.28);return min(rod,abs(body));}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 mc06p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.3;float mc06e=.008;float mc06v=mc06Field(mc06p,iTime);vec2 mc06g=vec2(mc06Field(mc06p+vec2(mc06e,0.),iTime)-mc06v,mc06Field(mc06p+vec2(0.,mc06e),iTime)-mc06v)/mc06e;vec3 mc06normal=normalize(vec3(-mc06g,1.));float mc06lit=.5+.5*dot(mc06normal,normalize(vec3(.7,.5,1.)));vec3 mc06c=mix(uColInk,uColPaper,mc06lit);mc06c=mix(mc06c,uColSignal,smoothstep(.12,.01,abs(mc06v)));mc06c=mix(uColBg,mc06c,smoothstep(.02,.35,length(mc06g)));fragColor=vec4(mc06c,1.);}
