float mc10Field(vec2 p,float t){float d=6.;vec2 centers[3]=vec2[3](vec2(0,.45),vec2(-.55,-.25),vec2(.55,-.25));for(int k=0;k<3;k++){vec2 q=p-centers[k];float a=atan(q.y,q.x),r=length(q);float phase=k==0?t:-t*(.7+.3*float(k));d=min(d,abs(r-(.28+.045*sin(10.*a+phase))));}return d;}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 mc10p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.5;float mc10layers=0.;for(int mc10k=0;mc10k<6;mc10k++){float mc10s=float(mc10k);vec2 mc10q=mc10p*(1.+mc10s*.13)+.08*vec2(sin(mc10s+iTime),cos(mc10s*.7-iTime));mc10layers+=sin(mc10Field(mc10q,iTime)*3.+mc10s);}float mc10v=.5+.5*sin(mc10layers);vec3 mc10c=mix(uColBg,uColPaper,mc10v*.55);mc10c=mix(mc10c,uColSignal,smoothstep(.65,.96,mc10v));mc10c=mix(mc10c,uColAccent,smoothstep(.92,1.,1.-mc10v));fragColor=vec4(mc10c,1.);}
