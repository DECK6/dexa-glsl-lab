float cv10Field(vec2 p,float t){float d=9.;for(int tooth=0;tooth<8;tooth++){float base=6.28318*float(tooth)/8.+t*.08;for(int k=0;k<24;k++){float u=float(k)/23.*1.1;vec2 q=vec2(cos(base+u)+u*sin(base+u),sin(base+u)-u*cos(base+u))*.62;d=min(d,length(p-q));}}return d;}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 cv10p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.5;float cv10layers=0.;for(int cv10k=0;cv10k<6;cv10k++){float cv10s=float(cv10k);vec2 cv10q=cv10p*(1.+cv10s*.13)+.08*vec2(sin(cv10s+iTime),cos(cv10s*.7-iTime));cv10layers+=sin(cv10Field(cv10q,iTime)*3.+cv10s);}float cv10v=.5+.5*sin(cv10layers);vec3 cv10c=mix(uColBg,uColPaper,cv10v*.55);cv10c=mix(cv10c,uColSignal,smoothstep(.65,.96,cv10v));cv10c=mix(cv10c,uColAccent,smoothstep(.92,1.,1.-cv10v));fragColor=vec4(cv10c,1.);}
