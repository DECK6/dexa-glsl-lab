vec2 cv07Cat(vec2 a,vec2 b,vec2 c,vec2 d,float u){return .5*((2.*b)+(-a+c)*u+(2.*a-5.*b+4.*c-d)*u*u+(-a+3.*b-3.*c+d)*u*u*u);} float cv07Field(vec2 p,float t){vec2 a=vec2(-1.5,-.3),b=vec2(-.8,.7),c=vec2(0.,.1+.2*sin(t*.5)),d=vec2(.75,-.75),e=vec2(1.5,.35);float m=8.;for(int k=0;k<48;k++){float u=float(k)/24.;vec2 q=u<1.?cv07Cat(a,b,c,d,u):cv07Cat(b,c,d,e,u-1.);m=min(m,length(p-q));}return m;}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 cv07p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.6;float cv07warp=cv07Field(cv07p*.7,iTime);cv07p+=.22*vec2(cos(cv07warp*3.+iTime),sin(cv07warp*2.-iTime));float cv07v=cv07Field(cv07p,iTime);float cv07ridge=exp(-3.5*abs(sin(cv07v*4.)));vec3 cv07c=mix(uColBg,uColInk,.55+.35*sin(cv07v));cv07c=mix(cv07c,uColSignal,cv07ridge);cv07c+=uColAccent*.18*smoothstep(.8,1.,cv07ridge);fragColor=vec4(cv07c,1.);}
