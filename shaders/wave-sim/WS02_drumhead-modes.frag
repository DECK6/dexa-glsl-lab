float ws02Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 ws02Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=ws02Read(uv);if(iFrame==0){vec2 p=uv-.5;float h=sin(p.x*9.42)*sin(p.y*12.56)*exp(-3.*dot(p,p));state=vec4(.5+.35*h,.5,0.,1.);return;}vec4 n=ws02Read(uv+vec2(0.,px.y)),s=ws02Read(uv-vec2(0.,px.y)),e=ws02Read(uv+vec2(px.x,0.)),w=ws02Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float h=c.r*2.-1.,v=c.g*2.-1.;float nh=lap.r*2.;float rim=smoothstep(.48,.43,length(uv-.5));v=(v+.22*nh)*.987*rim;h=(h+v)*rim;state=vec4(h*.5+.5,v*.5+.5,1.-rim,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.04,.35,abs(q.r-.5)*2.);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
