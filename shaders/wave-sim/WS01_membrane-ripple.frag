float ws01Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 ws01Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=ws01Read(uv);if(iFrame==0){float h=exp(-220.*dot(uv-vec2(.35,.5),uv-vec2(.35,.5)));state=vec4(.5+.5*h,.5,0.,1.);return;}vec4 n=ws01Read(uv+vec2(0.,px.y)),s=ws01Read(uv-vec2(0.,px.y)),e=ws01Read(uv+vec2(px.x,0.)),w=ws01Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float h=c.r*2.-1.,v=c.g*2.-1.;float nh=(n.r+s.r+e.r+w.r)*.5-2.;v=(v+.18*nh)*.992;h+=v;state=vec4(h*.5+.5,v*.5+.5,abs(nh),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float height=q.r*2.-1.;float radial=length(uv-vec2(.35,.5));float rings=pow(.5+.5*cos(radial*58.-iTime*2.2+height*9.),10.);float displacement=smoothstep(.015,.22,abs(height));vec3 col=mix(uColBg,uColDim,.14+.28*displacement);col=mix(col,uColSignal,rings*(.3+.7*displacement));col+=uColPaper*displacement*.42+uColAccent*rings*.16;fragColor=vec4(col,1.);}
