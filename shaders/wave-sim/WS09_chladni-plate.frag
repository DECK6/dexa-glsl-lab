float ws09Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 ws09Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=ws09Read(uv);if(iFrame==0){float h=.3*sin(uv.x*9.42)*sin(uv.y*15.7);state=vec4(.5+h,.5,0.,1.);return;}vec4 n=ws09Read(uv+vec2(0.,px.y)),s=ws09Read(uv-vec2(0.,px.y)),e=ws09Read(uv+vec2(px.x,0.)),w=ws09Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float h=c.r*2.-1.,v=(c.g*2.-1.)+.19*lap.r;float nodes=sin(uv.x*9.42)*sin(uv.y*15.7);v+=.002*nodes;v*=.987;h+=v;state=vec4(h*.5+.5,v*.5+.5,abs(nodes),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.04,.35,abs(q.r-.5)*2.);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
