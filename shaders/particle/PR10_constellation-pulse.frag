float pr10Seg(vec2 p,vec2 a,vec2 b){vec2 q=p-a,d=b-a;return length(q-d*clamp(dot(q,d)/dot(d,d),0.,1.));} float pr10Field(vec2 p,float t){vec2 a=vec2(-.9,-.4),b=vec2(-.3,.65),c=vec2(.45,.2),d=vec2(.9,-.65);float line=min(pr10Seg(p,a,b),min(pr10Seg(p,b,c),pr10Seg(p,c,d)));float phase=fract(t*.12);vec2 pulse=phase<.333?mix(a,b,phase*3.):phase<.666?mix(b,c,(phase-.333)*3.):mix(c,d,(phase-.666)*3.);return min(line,length(p-pulse)-.06);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 pr10p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.5;float pr10layers=0.;for(int pr10k=0;pr10k<6;pr10k++){float pr10s=float(pr10k);vec2 pr10q=pr10p*(1.+pr10s*.13)+.08*vec2(sin(pr10s+iTime),cos(pr10s*.7-iTime));pr10layers+=sin(pr10Field(pr10q,iTime)*3.+pr10s);}float pr10v=.5+.5*sin(pr10layers);vec3 pr10c=mix(uColBg,uColPaper,pr10v*.55);pr10c=mix(pr10c,uColSignal,smoothstep(.65,.96,pr10v));pr10c=mix(pr10c,uColAccent,smoothstep(.92,1.,1.-pr10v));fragColor=vec4(pr10c,1.);}
