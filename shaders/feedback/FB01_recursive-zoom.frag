float fb01Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 fb01Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fb01Read(uv);if(iFrame==0){float seed=step(abs(length(uv-.5)-.18),.012);state=vec4(seed,.2*seed,0.,1.);return;}vec4 n=fb01Read(uv+vec2(0.,px.y)),s=fb01Read(uv-vec2(0.,px.y)),e=fb01Read(uv+vec2(px.x,0.)),w=fb01Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 p=(uv-.5)*1.012+.5;vec4 echo=fb01Read(p);float seed=step(abs(length(uv-.5)-(.18+.04*sin(float(iFrame)*.05))),.008);state=vec4(max(echo.r*.985,seed),echo.g*.98,abs(c.r-echo.r),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b)*(.65+.35*cos(length(uv-.5)*12.+iTime));float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
