float fb07Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 fb07Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fb07Read(uv);if(iFrame==0){vec2 p=uv-.5;float ring=step(.9,cos(log(length(p)+.02)*15.));state=vec4(ring,0.,0.,1.);return;}vec4 n=fb07Read(uv+vec2(0.,px.y)),s=fb07Read(uv-vec2(0.,px.y)),e=fb07Read(uv+vec2(px.x,0.)),w=fb07Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 p=uv-.5;float r=length(p),a=atan(p.y,p.x)+.008;vec2 q=.5+(.996*r)*vec2(cos(a),sin(a));vec4 echo=fb07Read(q);float ring=step(.94,cos(log(r+.025)*18.-float(iFrame)*.05));state=vec4(max(echo.r*.978,ring),r,abs(c.r-echo.r),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b)*(.65+.35*cos(length(uv-.5)*24.+iTime));float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
