float fb05Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 fb05Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fb05Read(uv);if(iFrame==0){float halfv=step(.5,uv.x)*step(abs(uv.y-.5),.08);state=vec4(halfv,0.,0.,1.);return;}vec4 n=fb05Read(uv+vec2(0.,px.y)),s=fb05Read(uv-vec2(0.,px.y)),e=fb05Read(uv+vec2(px.x,0.)),w=fb05Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 q=vec2(1.-uv.x,uv.y);vec4 echo=fb05Read(q+vec2(.004*sin(float(iFrame)*.03),0.));float gate=step(.5+.18*sin(float(iFrame)*.02),uv.x);state=vec4(mix(c.r*.985,echo.r,gate*.12),gate,abs(c.r-echo.r),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b)*(.65+.35*cos(length(uv-.5)*20.+iTime));float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
