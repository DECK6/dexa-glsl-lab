float fb02Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 fb02Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fb02Read(uv);if(iFrame==0){vec2 p=uv-.5;float seed=step(.86,cos(atan(p.y,p.x)*6.))*step(length(p),.32);state=vec4(seed,0.,seed,1.);return;}vec4 n=fb02Read(uv+vec2(0.,px.y)),s=fb02Read(uv-vec2(0.,px.y)),e=fb02Read(uv+vec2(px.x,0.)),w=fb02Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 p=uv-.5;float a=atan(p.y,p.x);a=abs(mod(a+.5236,1.0472)-.5236);vec2 q=.5+length(p)*vec2(cos(a),sin(a))*.992;vec4 echo=fb02Read(q);state=vec4(echo.r*.982,max(echo.g*.96,abs(lap.r)*2.),mix(echo.b,c.r,.06),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b)*(.65+.35*cos(length(uv-.5)*14.+iTime));float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
