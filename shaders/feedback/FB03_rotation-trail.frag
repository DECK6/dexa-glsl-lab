float fb03Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 fb03Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fb03Read(uv);if(iFrame==0){float seed=step(abs(uv.x-.5),.02)+step(abs(uv.y-.5),.02);state=vec4(clamp(seed,0.,1.),0.,0.,1.);return;}vec4 n=fb03Read(uv+vec2(0.,px.y)),s=fb03Read(uv-vec2(0.,px.y)),e=fb03Read(uv+vec2(px.x,0.)),w=fb03Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float a=.012;vec2 p=uv-.5;vec2 q=.5+mat2(cos(a),-sin(a),sin(a),cos(a))*p*.996;vec4 echo=fb03Read(q);float spark=step(.995,fb03Hash(floor(fragCoord)+float(iFrame)));state=vec4(max(echo.r*.987,spark),mix(echo.g,c.r,.04),abs(c.r-echo.r),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b)*(.65+.35*cos(length(uv-.5)*16.+iTime));float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
