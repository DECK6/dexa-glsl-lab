float fb06Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 fb06Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fb06Read(uv);if(iFrame==0){float bits=step(.55,fb06Hash(floor(fragCoord/6.)));state=vec4(bits,0.,0.,1.);return;}vec4 n=fb06Read(uv+vec2(0.,px.y)),s=fb06Read(uv-vec2(0.,px.y)),e=fb06Read(uv+vec2(px.x,0.)),w=fb06Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec4 neighbor=mix(w,e,step(c.r,.5));float swap=step(.5,fb06Hash(floor(fragCoord/5.)+floor(float(iFrame)/4.)));state=vec4(mix(c.r,neighbor.r,swap*.18),mix(c.g,abs(lap.r),.1),swap,c.a);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b)*(.65+.35*cos(length(uv-.5)*22.+iTime));float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
