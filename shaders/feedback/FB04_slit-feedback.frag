float fb04Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 fb04Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fb04Read(uv);if(iFrame==0){float bars=step(.85,sin(uv.y*44.));state=vec4(bars,0.,0.,1.);return;}vec4 n=fb04Read(uv+vec2(0.,px.y)),s=fb04Read(uv-vec2(0.,px.y)),e=fb04Read(uv+vec2(px.x,0.)),w=fb04Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float slit=.5+.22*sin(float(iFrame)*.031);vec4 scan=fb04Read(vec2(slit,uv.y));float gate=step(abs(uv.x-slit),.009);state=vec4(mix(c.r*.982,scan.r,gate),gate,max(c.b*.95,abs(scan.r-c.r)),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b)*(.65+.35*cos(length(uv-.5)*18.+iTime));float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
