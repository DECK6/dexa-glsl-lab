float gr06Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 gr06Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=gr06Read(uv);if(iFrame==0){float colony=step(length(uv-vec2(.3,.35)),.06);state=vec4(colony,1.-colony,0.,1.);return;}vec4 n=gr06Read(uv+vec2(0.,px.y)),s=gr06Read(uv-vec2(0.,px.y)),e=gr06Read(uv+vec2(px.x,0.)),w=gr06Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float moisture=.5+.5*sin(uv.x*17.+uv.y*13.);float spread=step(.16,avg.r)*(1.-c.r)*step(.42,moisture);float grow=spread*step(.64,gr06Hash(floor(fragCoord)+float(iFrame)*.11));state=vec4(max(c.r,grow),mix(c.g,moisture,.04),grow,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=q.r*(.6+.4*sin(atan(uv.y-.5,uv.x-.5)*8.+iTime));float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
