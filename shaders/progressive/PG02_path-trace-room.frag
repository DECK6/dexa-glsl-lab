float pg02Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 pg02Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=pg02Read(uv);if(iFrame==0){float seed=step(max(abs(uv.x-.5),abs(uv.y-.5)),.34);state=vec4(seed,seed*seed,0.,1.);return;}vec4 n=pg02Read(uv+vec2(0.,px.y)),s=pg02Read(uv-vec2(0.,px.y)),e=pg02Read(uv+vec2(px.x,0.)),w=pg02Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float jitter=pg02Hash(fragCoord+float(iFrame));vec2 p=uv-.5;float wall=step(max(abs(p.x),abs(p.y)),.38);float light=exp(-18.*length(p-vec2(.18,.24)))*(.6+.4*jitter);float samplev=wall*light;float weight=1./min(float(iFrame)+1.,80.);state=vec4(mix(c.r,samplev,weight),mix(c.g,wall,weight),abs(samplev-c.r),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=clamp(q.b*1.3,0.,1.);float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
