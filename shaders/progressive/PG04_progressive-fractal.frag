float pg04Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 pg04Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=pg04Read(uv);if(iFrame==0){float seed=step(.9,cos(length(uv-.5)*28.));state=vec4(seed,seed*seed,0.,1.);return;}vec4 n=pg04Read(uv+vec2(0.,px.y)),s=pg04Read(uv-vec2(0.,px.y)),e=pg04Read(uv+vec2(px.x,0.)),w=pg04Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 z=(uv-.5)*2.4;vec2 c0=vec2(-.72,.22);int limit=4+int(mod(float(iFrame),28.));float escaped=0.;for(int k=0;k<32;k++){if(k>=limit)break;z=vec2(z.x*z.x-z.y*z.y,2.*z.x*z.y)+c0;if(dot(z,z)>4.){escaped=float(k)/32.;break;}}state=vec4(max(c.r,escaped),mix(c.g,escaped,.08),float(limit)/32.,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=clamp(q.b*1.5,0.,1.);float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
