float pg10Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 pg10Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=pg10Read(uv);if(iFrame==0){float seed=0.;state=vec4(seed,seed*seed,0.,1.);return;}vec4 n=pg10Read(uv+vec2(0.,px.y)),s=pg10Read(uv-vec2(0.,px.y)),e=pg10Read(uv+vec2(px.x,0.)),w=pg10Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float samplev=.5+.5*sin(uv.x*23.+pg10Hash(fragCoord+float(iFrame))*2.);float weight=1./min(float(iFrame)+1.,96.);float mean=mix(c.r,samplev,weight);float variance=mix(c.g,(samplev-mean)*(samplev-mean),weight);state=vec4(mean,variance,sqrt(variance),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=clamp(q.b*2.1,0.,1.);float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
