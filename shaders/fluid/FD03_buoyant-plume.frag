float fd03Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 fd03Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fd03Read(uv);if(iFrame==0){float plume=step(abs(uv.x-.5),.045)*step(uv.y,.18);state=vec4(.5,.64,plume,1.);return;}vec4 n=fd03Read(uv+vec2(0.,px.y)),s=fd03Read(uv-vec2(0.,px.y)),e=fd03Read(uv+vec2(px.x,0.)),w=fd03Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float source=step(length(uv-vec2(.5,.06)),.055);vec2 v=(c.rg-.5)*2.;v+=vec2((e.b-w.b)*-.06,.018+.1*c.b);vec4 adv=fd03Read(uv-v*px*2.5);state=vec4(clamp(v*.5+.5,0.,1.),max(adv.b*.987,source),clamp(avg.a,0.,1.));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.08,.6,length(q.rg-.5)*2.);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
