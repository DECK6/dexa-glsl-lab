float fd04Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 fd04Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fd04Read(uv);if(iFrame==0){float seed=step(length(uv-vec2(.5,.78)),.07);state=vec4(.7,.5,seed,1.);return;}vec4 n=fd04Read(uv+vec2(0.,px.y)),s=fd04Read(uv-vec2(0.,px.y)),e=fd04Read(uv+vec2(px.x,0.)),w=fd04Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 v=(c.rg-.5)*2.;v=mix(v,(avg.rg-.5)*2.,.12);v.x+=.03*smoothstep(.82,1.,uv.y);v*=step(.03,uv.x)*step(uv.x,.97)*step(.03,uv.y)*step(uv.y,.97);state=vec4(v*.5+.5,mix(c.b,abs(v.x-v.y),.08),length(v));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.08,.6,length(q.rg-.5)*2.);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
