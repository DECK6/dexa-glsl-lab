float fd05Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 fd05Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fd05Read(uv);if(iFrame==0){float bands=.5+.5*sin(uv.x*25.);state=vec4(.5+.18*sin(uv.y*6.28),.5+.16*sin(uv.x*12.56),bands,1.);return;}vec4 n=fd05Read(uv+vec2(0.,px.y)),s=fd05Read(uv-vec2(0.,px.y)),e=fd05Read(uv+vec2(px.x,0.)),w=fd05Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 drive=vec2(sin(6.283*uv.y),cos(12.566*uv.x));vec2 v=mix((c.rg-.5)*2.,drive*.45,.035);vec4 adv=fd05Read(uv-v*px*4.);state=vec4(v*.5+.5,mix(adv.b,.5+.5*sin(uv.x*19.+float(iFrame)*.03),.025),abs(lap.b));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.08,.6,length(q.rg-.5)*2.);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
