float fd08Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 fd08Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fd08Read(uv);if(iFrame==0){float jet=step(uv.x,.12)*step(abs(uv.y-.5),.035);state=vec4(.78,.5,jet,1.);return;}vec4 n=fd08Read(uv+vec2(0.,px.y)),s=fd08Read(uv-vec2(0.,px.y)),e=fd08Read(uv+vec2(px.x,0.)),w=fd08Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float pulse=.5+.5*sin(float(iFrame)*.12);float nozzle=step(uv.x,.07)*step(abs(uv.y-.5),.04+.03*pulse);vec2 v=mix((c.rg-.5)*2.,(avg.rg-.5)*2.,.08)+vec2(nozzle*.42,0.);vec4 adv=fd08Read(uv-v*px*4.);state=vec4(clamp(v*.5+.5,0.,1.),max(adv.b*.982,nozzle),pulse);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.08,.6,length(q.rg-.5)*2.);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
