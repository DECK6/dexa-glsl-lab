float fd02Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 fd02Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fd02Read(uv);if(iFrame==0){vec2 p=uv-.5;float curl=step(abs(length(p)-.24),.025);state=vec4(.5-p.y*.35,.5+p.x*.35,curl,1.);return;}vec4 n=fd02Read(uv+vec2(0.,px.y)),s=fd02Read(uv-vec2(0.,px.y)),e=fd02Read(uv+vec2(px.x,0.)),w=fd02Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float curl=(e.g-w.g)-(n.r-s.r);vec2 force=vec2(n.b-s.b,w.b-e.b);vec2 v=clamp((c.rg-.5)*2.+.12*force+.035*vec2(-curl,curl),-.8,.8);state=vec4(v*.5+.5,max(avg.b*.992,abs(curl)*.35),abs(curl));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.08,.6,length(q.rg-.5)*2.);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
