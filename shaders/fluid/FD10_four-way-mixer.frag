float fd10Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 fd10Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=fd10Read(uv);if(iFrame==0){float streams=step(abs(uv.x-.5),.03)+step(abs(uv.y-.5),.03);state=vec4(.5+.16*sin(uv.y*9.),.5+.16*cos(uv.x*9.),clamp(streams,0.,1.),1.);return;}vec4 n=fd10Read(uv+vec2(0.,px.y)),s=fd10Read(uv-vec2(0.,px.y)),e=fd10Read(uv+vec2(px.x,0.)),w=fd10Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 p=uv-.5;vec2 target=normalize(vec2(-p.y,p.x)+.001)*.25;vec2 v=mix((c.rg-.5)*2.,target,.055);vec4 adv=fd10Read(uv-v*px*3.);float inject=max(step(abs(p.x),.025),step(abs(p.y),.025));state=vec4(v*.5+.5,max(adv.b*.975,inject),abs(lap.b));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.08,.6,length(q.rg-.5)*2.);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
