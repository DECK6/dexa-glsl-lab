float at01Field(vec2 p,float t){vec2 sun=vec2(.7*sin(t*.12),.25+.55*cos(t*.1));float mu=dot(normalize(vec3(p,1.)),normalize(vec3(sun,1.)));float phase=.75*(1.+mu*mu);return phase*exp(-1.8*max(0.,p.y+.45));}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 at01p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.4;float at01v=at01Field(at01p,iTime);float at01band=.5+.5*cos(10.*at01v);vec3 at01col=mix(uColBg,uColInk,.25+.55*smoothstep(.15,.9,at01band));at01col=mix(at01col,uColSignal,smoothstep(.82,.98,at01band));at01col+=uColAccent*.16*smoothstep(.08,0.,abs(fract(at01v*1.7)-.5));fragColor=vec4(at01col,1.);}
