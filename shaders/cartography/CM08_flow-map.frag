float cm08Field(vec2 p,float t){float d=5.;for(int k=0;k<7;k++){float a=6.28318*float(k)/7.;vec2 start=.9*vec2(cos(a),sin(a)),control=.3*vec2(cos(a+t*.1),-sin(a)),end=vec2(0.);for(int j=0;j<24;j++){float u=float(j)/23.;vec2 q=mix(mix(start,control,u),mix(control,end,u),u);d=min(d,length(p-q)-.008*float(k));}}return d;}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.4;float d=cm08Field(p,iTime);float ink=smoothstep(.055,.008,abs(d));float contour=smoothstep(.025,.004,abs(fract(length(p)*7.)-.5));float packet=pow(.5+.5*cos(atan(p.y,p.x)*7.-iTime*2.4-length(p)*8.),12.);vec3 col=mix(uColBg,uColDim,.18+.24*contour);col=mix(col,uColPaper,ink);col+=uColSignal*ink*packet*.9+uColAccent*packet*.16;fragColor=vec4(col,1.);}
