float cm06Field(vec2 p,float t){float depth=sin(p.x*1.7)+cos(p.y*2.3)+.25*sin(length(p)*8.-t*.15);float contour=abs(fract(depth*2.5)-.5);float buoy=min(length(p-vec2(-.6,.2)),length(p-vec2(.55,-.3)));return min(contour,buoy-.07);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 cm06p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.3;float cm06e=.008;float cm06v=cm06Field(cm06p,iTime);vec2 cm06g=vec2(cm06Field(cm06p+vec2(cm06e,0.),iTime)-cm06v,cm06Field(cm06p+vec2(0.,cm06e),iTime)-cm06v)/cm06e;vec3 cm06normal=normalize(vec3(-cm06g,1.));float cm06lit=.5+.5*dot(cm06normal,normalize(vec3(.7,.5,1.)));vec3 cm06c=mix(uColInk,uColPaper,cm06lit);cm06c=mix(cm06c,uColSignal,smoothstep(.12,.01,abs(cm06v)));cm06c=mix(uColBg,cm06c,smoothstep(.02,.35,length(cm06g)));fragColor=vec4(cm06c,1.);}
