float cm10Field(vec2 p,float t){float r=length(p),z=sqrt(max(0.,1.-r*r));vec3 n=normalize(vec3(p,z));float grid=min(abs(fract(atan(n.z,n.x)/6.28318*12.+t*.02)-.5),abs(fract(asin(n.y)/3.14159*8.)-.5));float route=abs(dot(n,normalize(vec3(.4,.8,-.3))));return min(grid,route);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 cm10p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.5;float cm10layers=0.;for(int cm10k=0;cm10k<6;cm10k++){float cm10s=float(cm10k);vec2 cm10q=cm10p*(1.+cm10s*.13)+.08*vec2(sin(cm10s+iTime),cos(cm10s*.7-iTime));cm10layers+=sin(cm10Field(cm10q,iTime)*3.+cm10s);}float cm10v=.5+.5*sin(cm10layers);vec3 cm10c=mix(uColBg,uColPaper,cm10v*.55);cm10c=mix(cm10c,uColSignal,smoothstep(.65,.96,cm10v));cm10c=mix(cm10c,uColAccent,smoothstep(.92,1.,1.-cm10v));fragColor=vec4(cm10c,1.);}
