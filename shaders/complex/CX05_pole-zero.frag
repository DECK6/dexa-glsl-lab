vec2 cx05Div(vec2 a,vec2 b){return vec2(a.x*b.x+a.y*b.y,a.y*b.x-a.x*b.y)/max(dot(b,b),.001);} float cx05Field(vec2 p,float t){vec2 z0=.65*vec2(cos(t*.37),sin(t*.37));vec2 p0=.48*vec2(cos(-t*.29),sin(-t*.29));vec2 w=cx05Div(p-z0,p-p0);return atan(w.y,w.x)+.35*log(.1+length(w));}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 cx05p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.7;float cx05sum=0.;for(int cx05i=0;cx05i<18;cx05i++){float cx05s=float(cx05i)/17.;vec2 cx05d=.36*cx05s*vec2(cos(cx05s*9.+iTime*.2),sin(cx05s*7.));cx05sum+=exp(-4.*abs(cx05Field(cx05p+cx05d,iTime-cx05s)));}float cx05ink=1.-exp(-cx05sum*.16);vec3 cx05c=mix(uColBg,uColDim,.35);cx05c=mix(cx05c,uColSignal,cx05ink);cx05c+=uColPaper*.18*cx05ink+uColAccent*.12*sin(cx05sum);fragColor=vec4(cx05c,1.);}
