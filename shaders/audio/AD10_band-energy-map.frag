float ad10Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float low=texture(iChannel0,vec2(.08,.5)).r,mid=texture(iChannel0,vec2(.35,.5)).r,high=texture(iChannel0,vec2(.72,.5)).r;float band=mix(low,mix(mid,high,step(.66,uv.x)),step(.33,uv.x));float cell=step(uv.y,band*(.7+.2*sin(iTime+uv.x*9.)));feature=cell;base=vec3(low,mid,high)*cell;float light=ad10Lum(base);float scan=pow(.5+.5*cos(uv.y*39.0+uv.x*15.0-iTime*1.4),13.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
