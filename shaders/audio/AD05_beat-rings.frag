float ad05Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float bass=texture(iChannel0,vec2(.06,.5)).r;float r=length(uv-.5);float rings=pow(.5+.5*cos(r*48.-iTime*(2.+bass*4.)),12.)*exp(-r*2.);feature=rings;base=vec3(rings*bass);float light=ad05Lum(base);float scan=pow(.5+.5*cos(uv.y*29.0+uv.x*10.0-iTime*1.4),13.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
