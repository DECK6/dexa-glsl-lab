float ad01Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float bin=floor(uv.x*48.)/48.;float amp=texture(iChannel0,vec2(bin,.5)).r;float bars=step(uv.y,amp)*step(.12,fract(uv.x*48.));feature=bars;base=mix(vec3(.05),vec3(amp),bars);float light=ad01Lum(base);float scan=pow(.5+.5*cos(uv.y*21.0+uv.x*6.0-iTime*1.4),13.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
