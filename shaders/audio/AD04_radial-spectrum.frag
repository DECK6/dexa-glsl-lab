float ad04Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec2 p=uv-.5;float a=atan(p.y,p.x)/6.283+.5;float amp=texture(iChannel0,vec2(a,.5)).r;float ring=smoothstep(.018,.003,abs(length(p)-(.18+.28*amp)));feature=ring;base=vec3(amp*ring);float light=ad04Lum(base);float scan=pow(.5+.5*cos(uv.y*27.0+uv.x*9.0-iTime*1.4),13.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
