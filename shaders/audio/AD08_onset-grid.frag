float ad08Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec2 cell=floor(uv*vec2(16.,10.));float band=(cell.x+.5)/16.;float nowv=texture(iChannel0,vec2(band,.5)).r;float prevv=texture(iChannel0,vec2(fract(band-.02*sin(iTime)),.5)).r;float onset=step(.08,nowv-prevv+.06*sin(iTime+cell.y));float tile=step(.08,min(fract(uv.x*16.),fract(uv.y*10.)));feature=onset*tile;base=vec3(feature);float light=ad08Lum(base);float scan=pow(.5+.5*cos(uv.y*35.0+uv.x*13.0-iTime*1.4),13.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
