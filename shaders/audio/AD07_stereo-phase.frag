float ad07Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float left=texture(iChannel0,vec2(uv.x,.5)).r;float right=texture(iChannel1,vec2(uv.x,.5)).b;vec2 point=.5+.36*vec2(left-.5,right-.5);float trace=exp(-180.*dot(uv-point,uv-point));feature=trace;base=vec3(trace,.5*trace,abs(left-right));float light=ad07Lum(base);float scan=pow(.5+.5*cos(uv.y*33.0+uv.x*12.0-iTime*1.4),13.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
