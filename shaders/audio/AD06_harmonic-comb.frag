float ad06Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float fundamental=.075+.015*sin(iTime*.25);float energy=0.;for(int k=1;k<=8;k++){float x=fundamental*float(k);float amp=texture(iChannel0,vec2(x,.5)).r;energy+=amp*smoothstep(.012,.002,abs(uv.x-x));}feature=clamp(energy,0.,1.);base=vec3(feature*step(uv.y,.25+energy*.6));float light=ad06Lum(base);float scan=pow(.5+.5*cos(uv.y*31.0+uv.x*11.0-iTime*1.4),13.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
