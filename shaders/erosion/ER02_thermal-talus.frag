float er02Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 er02Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=er02Read(uv);if(iFrame==0){float h=.2+.65*smoothstep(.9,.1,length(uv-.5));state=vec4(h,0.,0.,1.);return;}vec4 n=er02Read(uv+vec2(0.,px.y)),s=er02Read(uv-vec2(0.,px.y)),e=er02Read(uv+vec2(px.x,0.)),w=er02Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float drop=max(0.,max(max(c.r-n.r,c.r-s.r),max(c.r-e.r,c.r-w.r))-.045);float moved=min(drop,.018);state=vec4(clamp(c.r-moved+.12*max(0.,avg.r-c.r),0.,1.),0.,moved*8.,drop);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float slope=abs(q.r-texture(iChannel0,uv+vec2(.004,0.)).r);float motif=smoothstep(.04,.2,slope)*1.06;float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float scan=pow(.5+.5*cos(q.r*34.-iTime*1.2),9.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+scan*.11);fragColor=vec4(col,1.);}
