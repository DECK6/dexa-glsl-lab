float er10Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 er10Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=er10Read(uv);if(iFrame==0){float h=.72-.42*uv.y+.08*sin(uv.x*17.);state=vec4(h,0.,0.,1.);return;}vec4 n=er10Read(uv+vec2(0.,px.y)),s=er10Read(uv-vec2(0.,px.y)),e=er10Read(uv+vec2(px.x,0.)),w=er10Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float water=clamp(c.g+.012-.04*max(0.,c.g-avg.g),0.,1.);float flow=max(0.,c.r-s.r)*water;float sediment=clamp(c.b+flow*.05,0.,1.);float fan=smoothstep(.15,.45,uv.y)*step(abs(uv.x-.5),.18+.3*uv.y);float deposit=sediment*fan*.025;state=vec4(clamp(c.r-flow*.008+deposit,0.,1.),water*.985,sediment-deposit,fan);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.04,.2,abs(q.r-texture(iChannel0,uv+vec2(.004,0.)).r))*1.54;float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
