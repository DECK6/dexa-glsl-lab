float er04Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 er04Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=er04Read(uv);if(iFrame==0){float h=.75-.45*uv.y+.1*sin(uv.x*13.);state=vec4(h,0.,0.,1.);return;}vec4 n=er04Read(uv+vec2(0.,px.y)),s=er04Read(uv-vec2(0.,px.y)),e=er04Read(uv+vec2(px.x,0.)),w=er04Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float flow=max(0.,c.g+.015+avg.g*.2-.01);float slope=max(0.,c.r-s.r);float sediment=clamp(c.b+slope*flow*.08-.012,0.,1.);float deposit=sediment*step(slope,.025)*.06;state=vec4(clamp(c.r-slope*flow*.01+deposit,0.,1.),flow*.9,sediment-deposit,deposit*8.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float slope=abs(q.r-texture(iChannel0,uv+vec2(.004,0.)).r);float fan=step(abs(uv.x-.5),.1+.34*uv.y);float motif=max(smoothstep(.04,.2,slope),fan*pow(.5+.5*cos(uv.y*24.-iTime),10.));float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.12*motif);fragColor=vec4(col,1.);}
