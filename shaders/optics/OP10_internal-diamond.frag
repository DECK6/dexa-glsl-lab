float op10Field(vec2 p,float t){vec2 q=vec2(-.55,-.2);vec2 v=normalize(vec2(.72+.1*sin(t*.3),1.));float d=6.;for(int k=0;k<18;k++){vec2 rel=p-q;d=min(d,length(rel-v*clamp(dot(rel,v),0.,.16)));q+=v*.16;if(abs(q.x)+abs(q.y)>1.){vec2 n=normalize(vec2(sign(q.x),sign(q.y)));v=reflect(v,n);q*=.94;}}return d+.08*abs(abs(p.x)+abs(p.y)-1.);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 op10p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.5;float op10layers=0.;for(int op10k=0;op10k<6;op10k++){float op10s=float(op10k);vec2 op10q=op10p*(1.+op10s*.13)+.08*vec2(sin(op10s+iTime),cos(op10s*.7-iTime));op10layers+=sin(op10Field(op10q,iTime)*3.+op10s);}float op10v=.5+.5*sin(op10layers);vec3 op10c=mix(uColBg,uColPaper,op10v*.55);op10c=mix(op10c,uColSignal,smoothstep(.65,.96,op10v));op10c=mix(op10c,uColAccent,smoothstep(.92,1.,1.-op10v));fragColor=vec4(op10c,1.);}
