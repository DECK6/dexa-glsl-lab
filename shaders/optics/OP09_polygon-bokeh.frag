float op09Hex(vec2 p){p=abs(p);return max(dot(p,normalize(vec2(1.,1.732))),p.x)-.18;} float op09Field(vec2 p,float t){float d=4.;for(int k=0;k<9;k++){float a=6.28318*float(k)/9.+t*.07;vec2 c=.82*vec2(cos(a*1.7),sin(a));vec2 q=mat2(cos(a),-sin(a),sin(a),cos(a))*(p-c);d=min(d,abs(op09Hex(q)));}return d;}

