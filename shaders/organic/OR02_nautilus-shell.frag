float or02Field(vec2 p,float t){float a=atan(p.y,p.x)+t*.06,r=length(p);float spiral=abs(log(max(r,.01))-.18*a);float chambers=abs(fract(a/6.28318*16.+log(max(r,.02))*3.)-.5);return min(spiral,chambers*.12);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 or02q=(fragCoord-.5*iResolution.xy)/iResolution.y*2.8;float or02a=atan(or02q.y,or02q.x)+iTime*.06;float or02r=max(length(or02q),.01);float or02spiral=abs(fract((log(or02r)-.18*or02a)*2.)-.5);float or02chamber=abs(fract(or02a/6.28318*16.+log(or02r)*3.)-.5);float or02line=smoothstep(.12,.015,min(or02spiral,or02chamber*.45));vec3 or02c=mix(uColBg,uColInk,.5+.25*sin(log(or02r)*6.));or02c=mix(or02c,uColPaper,or02line);or02c+=uColSignal*.28*smoothstep(.5,.05,or02spiral)+uColAccent*.18*smoothstep(.12,.01,or02chamber);fragColor=vec4(or02c,1.);}
