float or06Hash(vec2 p){return fract(sin(dot(p,vec2(127.,269.))+uSeed)*43758.);} float or06Field(vec2 p,float t){vec2 cell=floor(p*4.),f=fract(p*4.)-.5;float angle=or06Hash(cell)*6.28;f=mat2(cos(angle),-sin(angle),sin(angle),cos(angle))*f;float pore=abs(length(f*vec2(1.,2.2))-(.22+.04*sin(t)));float wall=min(abs(f.x)-.44,abs(f.y)-.44);return min(abs(pore),abs(wall));}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 or06p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.3;float or06e=.008;float or06v=or06Field(or06p,iTime);vec2 or06g=vec2(or06Field(or06p+vec2(or06e,0.),iTime)-or06v,or06Field(or06p+vec2(0.,or06e),iTime)-or06v)/or06e;vec3 or06normal=normalize(vec3(-or06g,1.));float or06lit=.5+.5*dot(or06normal,normalize(vec3(.7,.5,1.)));vec3 or06c=mix(uColInk,uColPaper,or06lit);or06c=mix(or06c,uColSignal,smoothstep(.12,.01,abs(or06v)));or06c=mix(uColBg,or06c,smoothstep(.02,.35,length(or06g)));fragColor=vec4(or06c,1.);}
