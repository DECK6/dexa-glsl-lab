float or10Hash(vec2 p){return fract(sin(dot(p,vec2(91.7,157.3))+uSeed)*43758.);} float or10Field(vec2 p,float t){vec2 i=floor(p*3.),f=fract(p*3.)-.5;float d1=4.,d2=4.;for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){vec2 g=vec2(x,y),c=g+vec2(or10Hash(i+g),or10Hash(i+g+4.2))-.5+.05*sin(t+g);float d=length(f-c);if(d<d1){d2=d1;d1=d;}else if(d<d2)d2=d;}return d2-d1;}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 or10p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.5;float or10layers=0.;for(int or10k=0;or10k<6;or10k++){float or10s=float(or10k);vec2 or10q=or10p*(1.+or10s*.13)+.08*vec2(sin(or10s+iTime),cos(or10s*.7-iTime));or10layers+=sin(or10Field(or10q,iTime)*3.+or10s);}float or10v=.5+.5*sin(or10layers);vec3 or10c=mix(uColBg,uColPaper,or10v*.55);or10c=mix(or10c,uColSignal,smoothstep(.65,.96,or10v));or10c=mix(or10c,uColAccent,smoothstep(.92,1.,1.-or10v));fragColor=vec4(or10c,1.);}
