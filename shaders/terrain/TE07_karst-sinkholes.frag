float te07Hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7))+uSeed)*43758.5);} float te07Field(vec2 p,float t){vec2 i=floor(p*2.),f=fract(p*2.)-.5;float d=2.;for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){vec2 g=vec2(x,y);vec2 c=g+vec2(te07Hash(i+g),te07Hash(i+g+7.3))-.5;d=min(d,length(f-c));}return d+.08*sin(t+p.y*3.);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 te07p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.6;float te07warp=te07Field(te07p*.7,iTime);te07p+=.22*vec2(cos(te07warp*3.+iTime),sin(te07warp*2.-iTime));float te07v=te07Field(te07p,iTime);float te07ridge=exp(-3.5*abs(sin(te07v*4.)));vec3 te07c=mix(uColBg,uColInk,.55+.35*sin(te07v));te07c=mix(te07c,uColSignal,te07ridge);te07c+=uColAccent*.18*smoothstep(.8,1.,te07ridge);fragColor=vec4(te07c,1.);}
