float dp04Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 dp04Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=dp04Read(uv);if(iFrame==0){float brush=step(.88,sin(uv.x*38.+uv.y*7.))*step(abs(uv.y-.5),.18);state=vec4(brush,.05,0.,1.);return;}vec4 n=dp04Read(uv+vec2(0.,px.y)),s=dp04Read(uv-vec2(0.,px.y)),e=dp04Read(uv+vec2(px.x,0.)),w=dp04Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float tooth=.5+.5*sin(uv.x*67.)*sin(uv.y*53.);float drag=mix(w.r,c.r,.72);float paint=clamp(drag-.008*(1.-tooth),0.,1.);state=vec4(paint,tooth,max(c.b*.94,abs(drag-c.r)),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.05,.45,q.r+q.b*.4);float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
