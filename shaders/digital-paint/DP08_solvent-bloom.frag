float dp08Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 dp08Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=dp08Read(uv);if(iFrame==0){float drop=step(length(uv-.5),.09);state=vec4(.65*drop,drop,0.,1.);return;}vec4 n=dp08Read(uv+vec2(0.,px.y)),s=dp08Read(uv-vec2(0.,px.y)),e=dp08Read(uv+vec2(px.x,0.)),w=dp08Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float solvent=clamp(c.g+.16*lap.g-.01,0.,1.);float bloom=smoothstep(.12,.42,solvent)*(1.-c.r);float pigment=clamp(c.r+.1*lap.r*solvent-.018*bloom,0.,1.);state=vec4(pigment,solvent,bloom,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float radius=length(uv-.5);float front=smoothstep(.035,.006,abs(radius-(.12+.035*sin(iTime*.55))));float motif=max(smoothstep(.05,.45,q.r+q.b*.8),front);float contour=smoothstep(.065,.008,abs(fract((q.r+q.b+radius)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.18+.24*q.a);col=mix(col,uColPaper,clamp(q.r*.62+front*.48,0.,1.));col=mix(col,uColSignal,clamp(q.g*.45+contour*.32,0.,1.));col+=uColAccent*(q.b*.35+pulse*.18*motif);fragColor=vec4(col,1.);}
