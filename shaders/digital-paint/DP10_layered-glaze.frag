float dp10Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 dp10Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=dp10Read(uv);if(iFrame==0){float base=step(.74,dp10Hash(floor(fragCoord/8.)));state=vec4(.25*base,.15,.1*base,1.);return;}vec4 n=dp10Read(uv+vec2(0.,px.y)),s=dp10Read(uv-vec2(0.,px.y)),e=dp10Read(uv+vec2(px.x,0.)),w=dp10Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float layer=step(mod(float(iFrame),18.),1.);float glaze=.08*layer*(.5+.5*sin(uv.x*17.+uv.y*9.+float(iFrame)*.1));float pigment=clamp(c.r+.025*lap.r+glaze*(1.-c.r),0.,1.);state=vec4(pigment,mix(c.g,avg.g,.04),clamp(c.b+glaze*.3,0.,1.),layer);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.05,.45,q.r+q.b*.10);float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
