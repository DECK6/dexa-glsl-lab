float dp02Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(173.3,269.5)))*43758.545);}
vec4 dp02Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=dp02Read(uv);if(iFrame==0){float ink=step(length(uv-vec2(.42,.56)),.12);state=vec4(ink,.35*ink,0.,1.);return;}vec4 n=dp02Read(uv+vec2(0.,px.y)),s=dp02Read(uv-vec2(0.,px.y)),e=dp02Read(uv+vec2(px.x,0.)),w=dp02Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;float fiber=.5+.5*sin(uv.x*71.+uv.y*11.);float wet=clamp(c.g+.1*lap.g-.012,0.,1.);float ink=clamp(c.r+.14*lap.r*(.3+.7*fiber)*wet,0.,1.);state=vec4(ink,wet,max(c.b*.95,abs(lap.r)),fiber);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=smoothstep(.05,.45,q.r+q.b*.2);float contour=smoothstep(.065,.008,abs(fract((q.r+q.b)*8.)-.5));float pulse=.5+.5*sin(iTime*.73+uv.x*8.-uv.y*6.);vec3 col=mix(uColBg,uColDim,.12+.3*q.a);col=mix(col,uColPaper,clamp(q.r*.72+motif*.22,0.,1.));col=mix(col,uColSignal,clamp(q.g*.65+contour*.25,0.,1.));col+=uColAccent*(q.b*.35+pulse*.04*motif);fragColor=vec4(col,1.);}
