float cp05Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec2 mapv=texture(iChannel1,uv).rg-.5;vec2 warped=uv+mapv*(.04+.025*sin(iTime*.5));base=texture(iChannel0,warped).rgb;feature=length(mapv)*1.6;float lum=cp05Luma(base);float scan=pow(.5+.5*cos((uv.y*26.0-uv.x*9.0-iTime)),11.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
