float cp03Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec3 fg=texture(iChannel1,uv).rgb;float key=smoothstep(.32+.08*sin(iTime*.4),.72,cp03Luma(fg));base=mix(src,fg,key);feature=key;float lum=cp03Luma(base);float scan=pow(.5+.5*cos((uv.y*20.0-uv.x*7.0-iTime)),11.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
