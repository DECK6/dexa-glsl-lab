float cp09Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float noise=fract(sin(dot(floor(uv*90.),vec2(12.9898,78.233)))*43758.5);float phase=.5+.5*sin(iTime*.55);float mask=smoothstep(phase-.08,phase+.08,noise);base=mix(src,texture(iChannel1,uv).rgb,mask);feature=1.-smoothstep(.0,.08,abs(noise-phase));float lum=cp09Luma(base);float scan=pow(.5+.5*cos((uv.y*38.0-uv.x*13.0-iTime)),11.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
