float cp08Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float seam=.5+.08*sin(uv.y*9.+iTime*.45);vec3 a=texture(iChannel0,(uv-.5)*.9+.5).rgb;vec3 b=texture(iChannel1,(uv-.5)*1.12+.5).rgb;float side=smoothstep(seam-.015,seam+.015,uv.x);base=mix(a,b,side);feature=1.-smoothstep(.0,.025,abs(uv.x-seam));float lum=cp08Luma(base);float scan=pow(.5+.5*cos((uv.y*35.0-uv.x*12.0-iTime)),11.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
