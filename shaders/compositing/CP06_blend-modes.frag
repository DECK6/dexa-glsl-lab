float cp06Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec3 other=texture(iChannel1,uv).rgb;vec3 multiply=src*other,screen=1.-(1.-src)*(1.-other);float split=step(.5+.2*sin(iTime*.3),uv.x);base=mix(multiply,screen,split);feature=step(abs(uv.x-(.5+.2*sin(iTime*.3))),.006);float lum=cp06Luma(base);float scan=pow(.5+.5*cos((uv.y*29.0-uv.x*10.0-iTime)),11.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
