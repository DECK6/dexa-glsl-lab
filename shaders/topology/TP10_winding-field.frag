float tp10Field(vec2 p,float t){vec2 a=vec2(.42*cos(t*.31),.32*sin(t*.27));vec2 b=-a;float w=atan(p.y-a.y,p.x-a.x)-atan(p.y-b.y,p.x-b.x);float rings=abs(fract((w/6.28318+length(p)*.72)*6.)-.5);vec2 va=vec2(-(p-a).y,(p-a).x)/(dot(p-a,p-a)+.025);vec2 vb=-vec2(-(p-b).y,(p-b).x)/(dot(p-b,p-b)+.025);float stream=abs(sin(dot(normalize(va+vb),p)*18.+w*2.))*.12;return min(rings*.16,stream);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 tp10p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.5;float tp10layers=0.;for(int tp10k=0;tp10k<6;tp10k++){float tp10s=float(tp10k);vec2 tp10q=tp10p*(1.+tp10s*.13)+.08*vec2(sin(tp10s+iTime),cos(tp10s*.7-iTime));tp10layers+=sin(tp10Field(tp10q,iTime)*3.+tp10s);}float tp10v=.5+.5*sin(tp10layers);vec3 tp10c=mix(uColBg,uColPaper,tp10v*.55);tp10c=mix(tp10c,uColSignal,smoothstep(.65,.96,tp10v));tp10c=mix(tp10c,uColAccent,smoothstep(.92,1.,1.-tp10v));fragColor=vec4(tp10c,1.);}
