float tp02Ring(vec2 p,vec2 c,vec2 s,float a){p-=c;p=mat2(cos(a),-sin(a),sin(a),cos(a))*p;p/=s;return abs(length(p)-1.)*min(s.x,s.y);}float tp02Field(vec2 p,float t){float a=.18*sin(t*.45);float r1=tp02Ring(p,vec2(-.28,.08),vec2(.62,.34),a);float r2=tp02Ring(p,vec2(.28,.08),vec2(.62,.34),-a);float r3=tp02Ring(p,vec2(0.,-.24),vec2(.36,.68),1.5708+a);float weave=min(r1,min(r2,r3));float crossings=.018*sin(18.*p.x+6.*p.y+t);return weave+crossings;}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 tp02q=(fragCoord-.5*iResolution.xy)/iResolution.y*2.8;float tp02f=tp02Field(tp02q,iTime);float tp02line=smoothstep(.12,.015,abs(fract(tp02f*.75)-.5));float tp02halo=smoothstep(.45,.02,abs(tp02f));vec3 tp02c=mix(uColBg,uColDim,.22+.35*tp02halo);tp02c=mix(tp02c,uColPaper,tp02line);tp02c+=uColSignal*tp02halo*.35+uColAccent*tp02line*.18;fragColor=vec4(tp02c,1.);}
