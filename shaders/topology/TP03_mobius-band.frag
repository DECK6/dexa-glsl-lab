float tp03Field(vec2 p,float t){float d=8.;float tilt=.35+.12*sin(t*.4);for(int k=0;k<112;k++){float u=6.2831853*float(k)/111.;float twist=.5*u+t*.17;vec3 c=vec3(cos(u),sin(u),0.);vec3 edge=c+(.18*cos(twist))*vec3(cos(u)*cos(twist),sin(u)*cos(twist),sin(twist));vec2 q=vec2(edge.x,edge.y*.72+edge.z*tilt);d=min(d,length(p-q)-.025);}float seam=abs(length(p)-.82)-.012;return min(d,seam+.08);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 tp03p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.2;float tp03a=tp03Field(tp03p,iTime);float tp03b=tp03Field(mat2(.8,-.6,.6,.8)*tp03p*1.17,-iTime*.73);float tp03cross=smoothstep(.18,.01,abs(tp03a-tp03b));vec3 tp03col=mix(uColInk,uColPaper,.5+.5*sin(tp03a*5.));tp03col=mix(tp03col,uColSignal,tp03cross);tp03col=mix(uColBg,tp03col,smoothstep(.02,.75,abs(tp03a)+abs(tp03b)));fragColor=vec4(tp03col,1.);}
