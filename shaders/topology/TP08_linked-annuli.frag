float tp08Field(vec2 p,float t){float a=.3*sin(t*.38);vec2 q1=mat2(cos(a),-sin(a),sin(a),cos(a))*(p-vec2(-.25,0.));vec2 q2=mat2(cos(-a),-sin(-a),sin(-a),cos(-a))*(p-vec2(.25,0.));float r1=abs(length(q1*vec2(1.,1.45))-.48)-.045;float r2=abs(length(q2*vec2(1.45,1.))-.48)-.045;float cross=.02*sin(16.*p.x-13.*p.y+t);return min(r1+cross*smoothstep(.15,0.,abs(p.x)),r2-cross*smoothstep(.15,0.,abs(p.y)));}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 tp08p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.4;float tp08angle=atan(tp08p.y,tp08p.x);float tp08radius=length(tp08p);float tp08v=tp08Field(vec2(tp08angle,tp08radius),iTime);float tp08arc=smoothstep(.09,.01,abs(tp08radius-.55-.18*sin(tp08v)));vec3 tp08c=mix(uColBg,uColDim,.3+.25*cos(tp08v));tp08c=mix(tp08c,uColPaper,tp08arc);tp08c+=uColSignal*.28*smoothstep(.3,0.,abs(tp08v));fragColor=vec4(tp08c,1.);}
