float tp09Field(vec2 p,float t){vec2 q=p;float bend=.28*sin(t*.32);q+=bend*vec2(sin(2.4*p.y),sin(2.1*p.x));vec2 a=q+vec2(.34,.08);vec2 b=mat2(.86,-.5,.5,.86)*(q-vec2(.34,-.08));float ga=min(abs(fract(a.x*2.4)-.5),abs(fract(a.y*2.4)-.5));float gb=min(abs(fract(b.x*2.8)-.5),abs(fract(b.y*2.8)-.5));float wa=smoothstep(.9,.2,length(a));float wb=smoothstep(.9,.2,length(b));float transition=abs(wa-wb)-.035;return min(mix(.2,ga,wa),min(mix(.2,gb,wb),transition));}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 tp09p=(fragCoord-.5*iResolution.xy)/iResolution.y*3.;vec2 tp09tile=floor(tp09p);vec2 tp09f=fract(tp09p)-.5;float tp09v=tp09Field(tp09f+tp09tile*.17,iTime+dot(tp09tile,vec2(.13,.19)));float tp09mark=smoothstep(.16,.01,abs(tp09v));float tp09edge=smoothstep(.49,.45,max(abs(tp09f.x),abs(tp09f.y)));vec3 tp09c=mix(uColBg,uColInk,tp09edge);tp09c=mix(tp09c,uColAccent,tp09mark);tp09c+=uColSignal*.22*(1.-tp09edge);fragColor=vec4(tp09c,1.);}
