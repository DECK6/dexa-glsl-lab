float tp06Field(vec2 p,float t){float d=8.;float y=p.y;for(int k=0;k<3;k++){float j=float(k);float phase=y*4.6+j*2.094+t*.65;float x=.52*sin(phase)+.1*sin(phase*2.+j);float strand=abs(p.x-x)-(.035+.012*cos(phase));float gate=.025*sin(phase*3.)*(j-1.);d=min(d,strand+gate);}float node=abs(fract((y+t*.08)*2.3)-.5)-.035;return min(d,node+.14);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 tp06p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.3;float tp06e=.008;float tp06v=tp06Field(tp06p,iTime);vec2 tp06g=vec2(tp06Field(tp06p+vec2(tp06e,0.),iTime)-tp06v,tp06Field(tp06p+vec2(0.,tp06e),iTime)-tp06v)/tp06e;vec3 tp06normal=normalize(vec3(-tp06g,1.));float tp06lit=.5+.5*dot(tp06normal,normalize(vec3(.7,.5,1.)));vec3 tp06c=mix(uColInk,uColPaper,tp06lit);tp06c=mix(tp06c,uColSignal,smoothstep(.12,.01,abs(tp06v)));tp06c=mix(uColBg,tp06c,smoothstep(.02,.35,length(tp06g)));fragColor=vec4(tp06c,1.);}
