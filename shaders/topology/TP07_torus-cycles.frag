float tp07Field(vec2 p,float t){float d=8.;float drift=t*.18;for(int k=0;k<128;k++){float u=6.2831853*float(k)/127.;float major=.68+.18*cos(3.*u+drift);vec3 q=vec3(major*cos(2.*u),major*sin(2.*u),.18*sin(3.*u+drift));vec2 v=vec2(q.x,q.y*.72+q.z*.8);d=min(d,length(p-v)-.025);}float tor=abs(length(p*vec2(1.,1.25))-.7)-.018;return min(d,tor+.045*sin(6.*atan(p.y,p.x)));}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 tp07p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.6;float tp07warp=tp07Field(tp07p*.7,iTime);tp07p+=.22*vec2(cos(tp07warp*3.+iTime),sin(tp07warp*2.-iTime));float tp07v=tp07Field(tp07p,iTime);float tp07ridge=exp(-3.5*abs(sin(tp07v*4.)));vec3 tp07c=mix(uColBg,uColInk,.55+.35*sin(tp07v));tp07c=mix(tp07c,uColSignal,tp07ridge);tp07c+=uColAccent*.18*smoothstep(.8,1.,tp07ridge);fragColor=vec4(tp07c,1.);}
