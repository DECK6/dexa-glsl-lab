float tp04Field(vec2 p,float t){float d=8.;float turn=.25*sin(t*.3);for(int k=0;k<120;k++){float u=6.2831853*float(k)/119.;float r=1.-.36*cos(u);vec3 q=vec3(r*cos(u),.72*sin(u),.42*sin(2.*u));q.xy+=vec2(.18*sin(2.*u),.08*cos(3.*u));float c=cos(turn),s=sin(turn);vec2 v=vec2(q.x*c-q.z*s,q.y+q.z*.18);d=min(d,length(p-v)-.024);}float neck=abs(length((p-vec2(.05,.22))*vec2(.75,1.4))-.48)-.018;return min(d,neck);}

