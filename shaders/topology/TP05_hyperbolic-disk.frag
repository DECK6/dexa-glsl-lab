float tp05Field(vec2 p,float t){float r=length(p);if(r>1.08)return r-1.;vec2 z=p;float cell=8.;for(int k=0;k<7;k++){float a=atan(z.y,z.x);float n=7.;a=abs(mod(a+3.14159/n,6.28318/n)-3.14159/n);z=length(z)*vec2(cos(a),sin(a));z.x-=.42+.025*sin(t*.35);float q=max(dot(z,z),.001);z=z/q*.28;}cell=min(abs(z.y),abs(length(z)-.31));float boundary=abs(r-1.);return min(cell*(1.-r*r+.08),boundary);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 tp05p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.7;float tp05sum=0.;for(int tp05i=0;tp05i<18;tp05i++){float tp05s=float(tp05i)/17.;vec2 tp05d=.36*tp05s*vec2(cos(tp05s*9.+iTime*.2),sin(tp05s*7.));tp05sum+=exp(-4.*abs(tp05Field(tp05p+tp05d,iTime-tp05s)));}float tp05ink=1.-exp(-tp05sum*.16);vec3 tp05c=mix(uColBg,uColDim,.35);tp05c=mix(tp05c,uColSignal,tp05ink);tp05c+=uColPaper*.18*tp05ink+uColAccent*.12*sin(tp05sum);fragColor=vec4(tp05c,1.);}
