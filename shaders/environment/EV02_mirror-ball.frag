float ev02Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec2 p=uv*2.-1.;float rr=dot(p,p);float z=sqrt(max(0.,1.-rr));vec3 n=vec3(p,z);vec3 r=reflect(vec3(0.,0.,-1.),n);vec2 q=vec2(atan(r.z,r.x)/6.283+.5,asin(clamp(r.y,-1.,1.))/3.14159+.5);base=texture(iChannel0,q).rgb*step(rr,1.);feature=smoothstep(1.,.92,rr);float light=ev02Lum(base);float scan=pow(.5+.5*cos(uv.x*19.0-uv.y*10.0-iTime*.9),12.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
