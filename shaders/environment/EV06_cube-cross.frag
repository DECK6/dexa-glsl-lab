float ev06Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec2 cell=floor(uv*vec2(4.,3.));vec2 f=fract(uv*vec2(4.,3.));float face=cell.x+cell.y*4.;vec2 q=vec2(fract((f.x+face*.137)+iTime*.015),clamp((f.y+cell.y)/3.,0.,1.));base=texture(iChannel0,q).rgb;feature=step(min(min(f.x,f.y),min(1.-f.x,1.-f.y)),.025);float light=ev06Lum(base);float scan=pow(.5+.5*cos(uv.x*27.0-uv.y*14.0-iTime*.9),12.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
