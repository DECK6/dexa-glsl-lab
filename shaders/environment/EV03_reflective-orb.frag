float ev03Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec2 p=uv*2.-1.;float rr=dot(p,p);float z=sqrt(max(0.,1.-rr));vec3 n=normalize(vec3(p,z));float a=iTime*.25;mat2 rot=mat2(cos(a),-sin(a),sin(a),cos(a));n.xz=rot*n.xz;vec3 r=reflect(vec3(0.,0.,-1.),n);vec2 q=vec2(atan(r.z,r.x)/6.283+.5,asin(r.y)/3.14159+.5);base=texture(iChannel0,q).rgb*step(rr,1.);feature=pow(max(0.,r.y),7.);float light=ev03Lum(base);float scan=pow(.5+.5*cos(uv.x*21.0-uv.y*11.0-iTime*.9),12.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
