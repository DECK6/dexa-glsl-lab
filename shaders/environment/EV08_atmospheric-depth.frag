float ev08Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float depth=pow(1.-uv.y,1.6);float density=.32+.16*sin(iTime*.3);float trans=exp(-depth*density*3.);base=mix(uColDim,src,trans);feature=1.-trans;float light=ev08Lum(base);float scan=pow(.5+.5*cos(uv.x*31.0-uv.y*16.0-iTime*.9),12.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
