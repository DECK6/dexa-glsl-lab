float ev05Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 grid=vec2(6.,4.);vec2 cell=floor(uv*grid),f=fract(uv*grid);vec2 q=(cell+.5)/grid;q.x=fract(q.x+iTime*.018);vec3 diffuse=texture(iChannel0,q).rgb*.4;diffuse+=texture(iChannel0,q+vec2(.08,0)).rgb*.15+texture(iChannel0,q-vec2(.08,0)).rgb*.15;diffuse+=texture(iChannel0,q+vec2(0,.08)).rgb*.15+texture(iChannel0,q-vec2(0,.08)).rgb*.15;float border=step(min(min(f.x,f.y),min(1.-f.x,1.-f.y)),.045);float l=ev05Lum(diffuse);vec3 col=mix(uColBg,uColPaper,l*.72);col=mix(col,diffuse,.38);col=mix(col,uColSignal,border*.52);col+=uColAccent*pow(.5+.5*cos((cell.x+cell.y)*1.7-iTime),12.)*.12;fragColor=vec4(col,1.);}
