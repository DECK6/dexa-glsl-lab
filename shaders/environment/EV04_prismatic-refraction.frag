float ev04Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 p=uv-.5;float tri=max(abs(p.x)*.866+p.y*.5,-p.y)-.24;float prism=smoothstep(.025,-.025,tri);float edge=smoothstep(.026,.004,abs(tri));vec2 ray=normalize(p+vec2(.001));float spread=.018+.01*sin(iTime*.45);vec3 refracted=vec3(texture(iChannel0,uv+ray*spread).r,texture(iChannel0,uv).g,texture(iChannel0,uv-ray*spread).b);float spectrum=pow(.5+.5*cos(p.y*28.-p.x*9.-iTime),9.)*step(.12,p.x);vec3 col=mix(uColBg,uColDim,.16+prism*.18);col=mix(col,refracted,prism*.72);col+=uColPaper*edge*.72+uColSignal*spectrum*.35+uColAccent*spectrum*.22;fragColor=vec4(col,1.);}
