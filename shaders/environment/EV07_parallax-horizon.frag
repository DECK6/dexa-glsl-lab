float ev07Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;float farline=.66+.045*sin(uv.x*9.+iTime*.18);float midline=.46+.07*sin(uv.x*7.-iTime*.27)+.025*sin(uv.x*21.);float nearline=.24+.11*sin(uv.x*5.+iTime*.42);float farMask=step(uv.y,farline),midMask=step(uv.y,midline),nearMask=step(uv.y,nearline);vec3 farv=texture(iChannel0,vec2(fract(uv.x+iTime*.006),uv.y)).rgb;vec3 midv=texture(iChannel0,vec2(fract(uv.x+iTime*.014),uv.y)).rgb;vec3 nearv=texture(iChannel0,vec2(fract(uv.x+iTime*.03),uv.y)).rgb;vec3 col=mix(uColBg,farv,farMask*.35);col=mix(col,mix(uColDim,midv,.3),midMask*.72);col=mix(col,mix(uColInk,nearv,.18),nearMask);float ridges=smoothstep(.018,.003,min(abs(uv.y-farline),min(abs(uv.y-midline),abs(uv.y-nearline))));col+=uColSignal*ridges*.52+uColAccent*ridges*nearMask*.18;fragColor=vec4(col,1.);}
