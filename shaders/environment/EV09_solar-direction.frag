float ev09Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 sun=vec2(.66+.14*sin(iTime*.22),.65+.08*cos(iTime*.19));vec2 p=uv-sun;float r=length(p),a=atan(p.y,p.x);float disk=smoothstep(.075,.055,r);float halo=exp(-r*9.);float rays=pow(.5+.5*cos(a*18.+iTime*.35),20.)*exp(-r*4.);float reticle=smoothstep(.009,.002,abs(r-.13))+smoothstep(.008,.001,abs(p.x))*step(r,.2)+smoothstep(.008,.001,abs(p.y))*step(r,.2);vec3 env=texture(iChannel0,uv).rgb;vec3 col=mix(uColBg,env,.12);col+=uColPaper*disk+uColAccent*halo*.55+uColSignal*(rays*.28+reticle*.7);fragColor=vec4(col,1.);}
