float ev10Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float exposure=.8+.35*sin(iTime*.32);vec3 x=max(vec3(0.),src*exposure-.004);base=(x*(6.2*x+.5))/(x*(6.2*x+1.7)+.06);feature=abs(ev10Lum(base)-ev10Lum(src));float light=ev10Lum(base);float scan=pow(.5+.5*cos(uv.x*35.0-uv.y*18.0-iTime*.9),12.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
