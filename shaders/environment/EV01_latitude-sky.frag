float ev01Lum(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec2 q=vec2(fract(uv.x+.04*sin(iTime*.18)),.5+.5*sin((uv.y-.5)*3.14159));base=texture(iChannel0,q).rgb;feature=pow(.5+.5*cos((uv.y-.5)*12.566),8.);float light=ev01Lum(base);float scan=pow(.5+.5*cos(uv.x*17.0-uv.y*9.0-iTime*.9),12.);vec3 col=mix(uColBg,uColPaper,clamp(light,0.,1.));col=mix(col,base,.25);col=mix(col,uColSignal,clamp(feature,0.,1.)*.7);col+=uColAccent*scan*(.09+.12*feature)+uColDim*(1.-light)*.07;fragColor=vec4(col,1.);}
