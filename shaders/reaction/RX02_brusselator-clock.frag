float rx02Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx02Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx02Read(uv);if(iFrame==0){float a=.45+.12*sin(uv.x*19.);float b=.28+.16*cos(uv.y*17.);state=vec4(a,b,rx02Noise(floor(fragCoord/4.)),1.);return;}vec4 n4=rx02Read(uv+vec2(0,d.y))+rx02Read(uv-vec2(0,d.y))+rx02Read(uv+vec2(d.x,0))+rx02Read(uv-vec2(d.x,0));vec4 diag=rx02Read(uv+d)+rx02Read(uv-d)+rx02Read(uv+vec2(d.x,-d.y))+rx02Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;float x=c.r,y=c.g;float dx=.72*lap.r+.06*(1.-4.*x+x*x*y);float dy=.38*lap.g+.06*(3.*x-x*x*y);state=vec4(clamp(x+dx,0.,1.),clamp(y+dy,0.,1.),fract(c.b+.012+y*.01),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float edge=length(vec2(dFdx(q.r-q.g),dFdy(q.r-q.g)));float shimmer=.5+.5*sin(iTime*.7+uv.x*11.0+uv.y*7.0);float structure=smoothstep(.9,1.0,sin(uv.x*31.0+iTime)*sin(uv.y*13.0-iTime*.6));vec3 col=mix(uColBg,uColDim,.18+.25*q.b);col=mix(col,uColPaper,clamp(q.r-q.g*.35,0.0,1.0));col=mix(col,uColSignal,smoothstep(.08,.7,q.g));col=mix(col,uColInk,.28*structure);col+=uColAccent*edge*(1.45+.35*shimmer);fragColor=vec4(col,1.0);}
