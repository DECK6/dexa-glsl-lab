float rx01Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx01Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx01Read(uv);if(iFrame==0){vec2 p=uv-.5;float b=step(length(p),.12)+.12*rx01Noise(floor(fragCoord/3.));state=vec4(1.0-clamp(b,0.,1.),clamp(b,0.,1.),0.,1.);return;}vec4 n4=rx01Read(uv+vec2(0,d.y))+rx01Read(uv-vec2(0,d.y))+rx01Read(uv+vec2(d.x,0))+rx01Read(uv-vec2(d.x,0));vec4 diag=rx01Read(uv+d)+rx01Read(uv-d)+rx01Read(uv+vec2(d.x,-d.y))+rx01Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;float a=c.r,b=c.g;float react=a*b*b;a=clamp(a+.95*lap.r-react*.22+.035*(1.-a),0.,1.);b=clamp(b+.48*lap.g+react*.22-(.097)*b,0.,1.);state=vec4(a,b,mix(c.b,abs(a-b),.08),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float edge=length(vec2(dFdx(q.r-q.g),dFdy(q.r-q.g)));float shimmer=.5+.5*sin(iTime*.7+uv.x*11.0+uv.y*7.0);float structure=smoothstep(.92,1.0,cos(length(uv-.5)*52.0-iTime*.4));vec3 col=mix(uColBg,uColDim,.18+.25*q.b);col=mix(col,uColPaper,clamp(q.r-q.g*.35,0.0,1.0));col=mix(col,uColSignal,smoothstep(.08,.7,q.g));col=mix(col,uColInk,.28*structure);col+=uColAccent*edge*(1.45+.35*shimmer);fragColor=vec4(col,1.0);}
