float rx03Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx03Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx03Read(uv);if(iFrame==0){float spark=step(length(uv-vec2(.28,.52)),.06);state=vec4(.1+.8*spark,.18,0.,1.);return;}vec4 n4=rx03Read(uv+vec2(0,d.y))+rx03Read(uv-vec2(0,d.y))+rx03Read(uv+vec2(d.x,0))+rx03Read(uv-vec2(d.x,0));vec4 diag=rx03Read(uv+d)+rx03Read(uv-d)+rx03Read(uv+vec2(d.x,-d.y))+rx03Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;float v=c.r,w=c.g;float dv=.65*lap.r+.09*(v-v*v*v-(w-.35));float dw=.18*lap.g+.025*(v-.72*w);state=vec4(clamp(v+dv,0.,1.),clamp(w+dw,0.,1.),max(c.b*.96,abs(dv)),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float edge=length(vec2(dFdx(q.r-q.g),dFdy(q.r-q.g)));float radius=length(uv-vec2(.28,.52));float wave=pow(.5+.5*cos(radius*46.-iTime*2.4),12.)*exp(-radius*1.5);float shimmer=.5+.5*sin(iTime*.7+uv.x*11.0+uv.y*7.0);vec3 col=mix(uColBg,uColDim,.18+.25*q.b);col=mix(col,uColPaper,clamp(q.r-q.g*.35,0.0,1.0));col=mix(col,uColSignal,max(smoothstep(.08,.7,q.g),wave*.72));col+=uColAccent*(edge*(1.45+.35*shimmer)+wave*.18);fragColor=vec4(col,1.0);}
