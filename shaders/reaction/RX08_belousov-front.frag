float rx08Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx08Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx08Read(uv);if(iFrame==0){float phase=floor(rx08Noise(floor(fragCoord/6.))*3.);state=vec4(step(phase,.5),step(abs(phase-1.),.5),step(1.5,phase),1.);return;}vec4 n4=rx08Read(uv+vec2(0,d.y))+rx08Read(uv-vec2(0,d.y))+rx08Read(uv+vec2(d.x,0))+rx08Read(uv-vec2(d.x,0));vec4 diag=rx08Read(uv+d)+rx08Read(uv-d)+rx08Read(uv+vec2(d.x,-d.y))+rx08Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;vec3 q=c.rgb;vec3 pressure=vec3(lap.g,lap.b,lap.r);q=clamp(q+.48*pressure+.025*vec3(q.r*(q.g-q.b),q.g*(q.b-q.r),q.b*(q.r-q.g)),0.,1.);q/=max(1.,q.r+q.g+q.b);state=vec4(q,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float edge=length(vec2(dFdx(q.r-q.g),dFdy(q.r-q.g)));float shimmer=.5+.5*sin(iTime*.7+uv.x*11.0+uv.y*7.0);vec3 col=mix(uColBg,uColDim,.18+.25*q.b);col=mix(col,uColPaper,clamp(q.r-q.g*.35,0.0,1.0));col=mix(col,uColSignal,smoothstep(.08,.7,q.g));col+=uColAccent*edge*(1.45+.35*shimmer);fragColor=vec4(col,1.0);}
