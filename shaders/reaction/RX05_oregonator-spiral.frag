float rx05Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx05Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx05Read(uv);if(iFrame==0){float wedge=step(abs(uv.y-.5),.025)*step(uv.x,.52);state=vec4(.2+.7*wedge,.18,.12,1.);return;}vec4 n4=rx05Read(uv+vec2(0,d.y))+rx05Read(uv-vec2(0,d.y))+rx05Read(uv+vec2(d.x,0))+rx05Read(uv-vec2(d.x,0));vec4 diag=rx05Read(uv+d)+rx05Read(uv-d)+rx05Read(uv+vec2(d.x,-d.y))+rx05Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;float x=c.r,y=c.g,z=c.b;float xn=clamp(x+.42*lap.r+.055*(y+x*(1.-x)-z),0.,1.);float yn=clamp(y+.28*lap.g+.035*(z-y),0.,1.);float zn=clamp(z+.16*lap.b+.022*(x-z),0.,1.);state=vec4(xn,yn,zn,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float edge=length(vec2(dFdx(q.r-q.g),dFdy(q.r-q.g)));float shimmer=.5+.5*sin(iTime*.7+uv.x*11.0+uv.y*7.0);float structure=smoothstep(.9,1.0,cos(atan(uv.y-.5,uv.x-.5)*5.0-length(uv-.5)*28.0-iTime));vec3 col=mix(uColBg,uColDim,.18+.25*q.b);col=mix(col,uColPaper,clamp(q.r-q.g*.35,0.0,1.0));col=mix(col,uColSignal,smoothstep(.08,.7,q.g));col=mix(col,uColInk,.28*structure);col+=uColAccent*edge*(1.45+.35*shimmer);fragColor=vec4(col,1.0);}
