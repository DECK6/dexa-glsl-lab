float rx09Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx09Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx09Read(uv);if(iFrame==0){float side=smoothstep(.48,.52,uv.x);state=vec4(.2+.6*side,.7-.5*side,0.,1.);return;}vec4 n4=rx09Read(uv+vec2(0,d.y))+rx09Read(uv-vec2(0,d.y))+rx09Read(uv+vec2(d.x,0))+rx09Read(uv-vec2(d.x,0));vec4 diag=rx09Read(uv+d)+rx09Read(uv-d)+rx09Read(uv+vec2(d.x,-d.y))+rx09Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;float activ=c.r,inactive=c.g;float total=activ+inactive;float convert=.08*activ*activ/(.05+activ*activ)*inactive-.025*activ;activ=clamp(activ+.22*lap.r+convert,0.,1.);inactive=clamp(total-activ+.72*lap.g,0.,1.);state=vec4(activ,inactive,abs(lap.r)*2.,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float polarity=q.r-q.g+.55*tanh((uv.x-.5)*8.+.5*sin(uv.y*6.+iTime*.3));float boundary=smoothstep(.055,.008,abs(polarity));float domains=smoothstep(-.35,.35,polarity);float pins=pow(.5+.5*cos(uv.y*17.+polarity*8.-iTime*.8),11.)*boundary;vec3 col=mix(uColInk,uColPaper,domains*.78);col=mix(col,uColSignal,boundary*.72);col+=uColAccent*pins*.45+uColDim*q.b*.25;fragColor=vec4(col,1.);}
