float rx10Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx10Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx10Read(uv);if(iFrame==0){float cross=step(abs(uv.x-.5),.025)+step(abs(uv.y-.5),.025);state=vec4(.35+.4*clamp(cross,0.,1.),.28,0.,1.);return;}vec4 n4=rx10Read(uv+vec2(0,d.y))+rx10Read(uv-vec2(0,d.y))+rx10Read(uv+vec2(d.x,0))+rx10Read(uv-vec2(d.x,0));vec4 diag=rx10Read(uv+d)+rx10Read(uv-d)+rx10Read(uv+vec2(d.x,-d.y))+rx10Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;float a=c.r,b=c.g;float ax=(texture(iChannel0,uv+vec2(d.x,0)).r-texture(iChannel0,uv-vec2(d.x,0)).r);float by=(texture(iChannel0,uv+vec2(0,d.y)).g-texture(iChannel0,uv-vec2(0,d.y)).g);a=clamp(a+.52*lap.r+.04*(b-a)+.12*ax,0.,1.);b=clamp(b+.35*lap.g+.035*(a*b-b)+.12*by,0.,1.);state=vec4(a,b,abs(ax-by),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float edge=length(vec2(dFdx(q.r-q.g),dFdy(q.r-q.g)));float shimmer=.5+.5*sin(iTime*.7+uv.x*11.0+uv.y*7.0);float structure=smoothstep(.9,1.0,max(cos((uv.x-.5)*44.0+iTime*.4),cos((uv.y-.5)*42.0-iTime*.3)));vec3 col=mix(uColBg,uColDim,.18+.25*q.b);col=mix(col,uColPaper,clamp(q.r-q.g*.35,0.0,1.0));col=mix(col,uColSignal,smoothstep(.08,.7,q.g));col=mix(col,uColInk,.28*structure);col+=uColAccent*edge*(1.45+.35*shimmer);fragColor=vec4(col,1.0);}
