float rx04Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx04Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx04Read(uv);if(iFrame==0){float spots=step(.84,rx04Noise(floor(fragCoord/5.)));state=vec4(.62+.2*spots,.24+.5*spots,0.,1.);return;}vec4 n4=rx04Read(uv+vec2(0,d.y))+rx04Read(uv-vec2(0,d.y))+rx04Read(uv+vec2(d.x,0))+rx04Read(uv-vec2(d.x,0));vec4 diag=rx04Read(uv+d)+rx04Read(uv-d)+rx04Read(uv+vec2(d.x,-d.y))+rx04Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;float u=c.r,v=c.g;float term=u*u*v;u=clamp(u+.55*lap.r+.035*(.18-u+term),0.,1.);v=clamp(v+.92*lap.g+.035*(.72-term),0.,1.);state=vec4(u,v,abs(lap.r-lap.g),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float edge=length(vec2(dFdx(q.r-q.g),dFdy(q.r-q.g)));float shimmer=.5+.5*sin(iTime*.7+uv.x*11.0+uv.y*7.0);float structure=smoothstep(.88,1.0,cos(uv.x*39.0)*cos(uv.y*37.0+iTime*.5));vec3 col=mix(uColBg,uColDim,.18+.25*q.b);col=mix(col,uColPaper,clamp(q.r-q.g*.35,0.0,1.0));col=mix(col,uColSignal,smoothstep(.08,.7,q.g));col=mix(col,uColInk,.28*structure);col+=uColAccent*edge*(1.45+.35*shimmer);fragColor=vec4(col,1.0);}
