float rx06Noise(vec2 p){return fract(sin(dot(p+uSeed,vec2(41.7,289.3)))*45127.31);}
vec4 rx06Read(vec2 uv){return texture(iChannel0,clamp(uv,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 d=1.0/iChannelResolution[0].xy;vec4 c=rx06Read(uv);if(iFrame==0){float mixv=step(.5,rx06Noise(floor(fragCoord/3.)));state=vec4(mixv,1.-mixv,0.,1.);return;}vec4 n4=rx06Read(uv+vec2(0,d.y))+rx06Read(uv-vec2(0,d.y))+rx06Read(uv+vec2(d.x,0))+rx06Read(uv-vec2(d.x,0));vec4 diag=rx06Read(uv+d)+rx06Read(uv-d)+rx06Read(uv+vec2(d.x,-d.y))+rx06Read(uv+vec2(-d.x,d.y));vec4 lap=n4*.18+diag*.07-c;float phi=c.r*2.-1.;float mu=phi*phi*phi-phi-.7*lap.r;float neighborMu=(n4.r*.25)*2.-1.;float next=clamp(c.r+.055*(neighborMu-phi)-.018*mu,0.,1.);state=vec4(next,1.-next,abs(next-c.r)*8.,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float edge=length(vec2(dFdx(q.r-q.g),dFdy(q.r-q.g)));float shimmer=.5+.5*sin(iTime*.7+uv.x*11.0+uv.y*7.0);vec3 col=mix(uColBg,uColDim,.18+.25*q.b);col=mix(col,uColPaper,clamp(q.r-q.g*.35,0.0,1.0));col=mix(col,uColSignal,smoothstep(.08,.7,q.g));col+=uColAccent*edge*(1.45+.35*shimmer);fragColor=vec4(col,1.0);}
