float kc07Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float a=iTime*.22;vec2 dir=vec2(cos(a),sin(a))*px*2.;base=vec3(0.);for(int k=-4;k<=4;k++){base+=texture(iChannel0,uv+dir*float(k)).rgb/9.;}feature=length(src-base)*1.8;float lum=kc07Luma(base);float scan=pow(.5+.5*cos((uv.y*23.0-iTime*1.4)*6.283),14.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
