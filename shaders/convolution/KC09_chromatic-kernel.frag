float kc09Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;float spread=2.+2.*(.5+.5*sin(iTime*.55));base=vec3(texture(iChannel0,uv+vec2(px.x*spread,0)).r,src.g,texture(iChannel0,uv-vec2(px.x*spread,0)).b);feature=length(base-src)*2.;float lum=kc09Luma(base);float scan=pow(.5+.5*cos((uv.y*25.0-iTime*1.4)*6.283),14.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
