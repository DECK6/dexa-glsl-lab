float kc08Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec3 sum=src;float weight=1.;for(int k=1;k<=4;k++){vec2 o=vec2(float(k%2),float((k+1)%2))*px*float(1+k/2);vec3 q=texture(iChannel0,uv+o).rgb;float wt=exp(-12.*dot(q-src,q-src));sum+=q*wt;weight+=wt;}base=sum/weight;feature=length(src-base)*2.4;float lum=kc08Luma(base);float scan=pow(.5+.5*cos((uv.y*24.0-iTime*1.4)*6.283),14.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
