float kc03Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec3 tl=texture(iChannel0,uv+vec2(-px.x,px.y)).rgb,tr=texture(iChannel0,uv+px).rgb,bl=texture(iChannel0,uv-px).rgb,br=texture(iChannel0,uv+vec2(px.x,-px.y)).rgb;vec3 gx=tr+2.*texture(iChannel0,uv+vec2(px.x,0)).rgb+br-tl-2.*texture(iChannel0,uv-vec2(px.x,0)).rgb-bl;vec3 gy=tl+2.*texture(iChannel0,uv+vec2(0,px.y)).rgb+tr-bl-2.*texture(iChannel0,uv-vec2(0,px.y)).rgb-br;feature=length(vec2(kc03Luma(gx),kc03Luma(gy)));base=vec3(feature);float lum=kc03Luma(base);float scan=pow(.5+.5*cos((uv.y*19.0-iTime*1.4)*6.283),14.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
