float kc10Luma(vec3 c){return dot(c,vec3(.299,.587,.114));}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec3 src=texture(iChannel0,uv).rgb;vec3 base=src;float feature=0.;vec3 qa=(src+texture(iChannel0,uv+px).rgb+texture(iChannel0,uv+vec2(px.x,0)).rgb)/3.;vec3 qb=(src+texture(iChannel0,uv-px).rgb+texture(iChannel0,uv-vec2(px.x,0)).rgb)/3.;float va=length(qa-src),vb=length(qb-src);base=mix(qa,qb,step(vb,va));feature=abs(va-vb)*3.;float lum=kc10Luma(base);float scan=pow(.5+.5*cos((uv.y*26.0-iTime*1.4)*6.283),14.);vec3 col=mix(uColBg,uColPaper,clamp(lum,0.,1.));col=mix(col,base,.28);col=mix(col,uColSignal,clamp(feature,0.,1.)*.68);col+=uColAccent*scan*(.08+.14*feature)+uColDim*(1.-lum)*.08;fragColor=vec4(col,1.);}
