float sw03Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 sw03Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=sw03Read(uv);if(iFrame==0){float agents=step(.975,sw03Hash(floor(fragCoord/5.)));state=vec4(agents,0.,agents,1.);return;}vec4 n=sw03Read(uv+vec2(0.,px.y)),s=sw03Read(uv-vec2(0.,px.y)),e=sw03Read(uv+vec2(px.x,0.)),w=sw03Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 sensor=vec2(e.r-w.r,n.r-s.r);float deposit=step(.955,cos(dot(floor(fragCoord/3.),vec2(.31,.47))+float(iFrame)*.08+length(sensor)*9.));state=vec4(max(c.r*.97,deposit),mix(c.g,avg.r,.2),deposit,1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
