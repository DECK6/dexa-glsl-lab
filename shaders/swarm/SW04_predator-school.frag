float sw04Hash(vec2 p){return fract(sin(dot(p+uSeed,vec2(93.17,417.2)))*43758.54);}
vec4 sw04Read(vec2 p){return texture(iChannel0,clamp(p,0.0,1.0));}
void mainBuffer(out vec4 state,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec2 px=1.0/iChannelResolution[0].xy;vec4 c=sw04Read(uv);if(iFrame==0){float agents=step(.975,sw04Hash(floor(fragCoord/3.)));state=vec4(agents,0.,agents,1.);return;}vec4 n=sw04Read(uv+vec2(0.,px.y)),s=sw04Read(uv-vec2(0.,px.y)),e=sw04Read(uv+vec2(px.x,0.)),w=sw04Read(uv-vec2(px.x,0.));vec4 avg=(n+s+e+w)*.25;vec4 lap=n+s+e+w-4.*c;vec2 p=uv-.5;float predator=step(length(p-vec2(.28*cos(float(iFrame)*.025),.28*sin(float(iFrame)*.025))),.045);float prey=max(avg.r*.984,step(.982,sw04Hash(floor(fragCoord)+float(iFrame)*.11)));state=vec4(prey*(1.-predator),predator,max(c.b*.95,predator),1.);}
void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 uv=fragCoord/iResolution.xy;vec4 q=texture(iChannel0,uv);float motif=max(q.r,q.b);float edge=length(vec2(dFdx(q.b),dFdy(q.b)));float beat=.5+.5*sin(iTime*.83+uv.x*9.+uv.y*5.);vec3 col=mix(uColBg,uColInk,.14+.22*q.a);col=mix(col,uColSignal,clamp(q.b*.85+motif*.3,0.,1.));col=mix(col,uColAccent,clamp(q.g*motif,0.,1.)*.55);col+=uColPaper*(edge*.9+beat*.035*motif);fragColor=vec4(col,1.);}
