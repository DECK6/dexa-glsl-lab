float mt06Field(vec2 p,float t){float frost=sin(p.x*83.+sin(p.y*31.))+sin(p.y*97.-sin(p.x*27.));vec2 q=p+.018*vec2(frost,sin(frost*2.+t));float grid=min(abs(fract(q.x*4.)-.5),abs(fract(q.y*4.)-.5));return smoothstep(.18,.02,grid)+.12*frost;}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 mt06p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.3;float mt06e=.008;float mt06v=mt06Field(mt06p,iTime);vec2 mt06g=vec2(mt06Field(mt06p+vec2(mt06e,0.),iTime)-mt06v,mt06Field(mt06p+vec2(0.,mt06e),iTime)-mt06v)/mt06e;vec3 mt06normal=normalize(vec3(-mt06g,1.));float mt06lit=.5+.5*dot(mt06normal,normalize(vec3(.7,.5,1.)));vec3 mt06c=mix(uColInk,uColPaper,mt06lit);mt06c=mix(mt06c,uColSignal,smoothstep(.12,.01,abs(mt06v)));mt06c=mix(uColBg,mt06c,smoothstep(.02,.35,length(mt06g)));fragColor=vec4(mt06c,1.);}
