float mt05Hash(vec2 p){return fract(sin(dot(p,vec2(41.3,289.1))+uSeed)*43758.5);} float mt05Field(vec2 p,float t){vec2 cell=floor(p*7.),f=fract(p*7.)-.5;float h=mt05Hash(cell);vec2 c=vec2(mt05Hash(cell+3.1),mt05Hash(cell+8.7))-.5;float dent=exp(-9.*dot(f-c,f-c));float shine=pow(max(0.,.5+.5*sin((f.x-c.x)*4.+t+h*6.)),5.);return dent*.65+shine*.45;}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 mt05p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.7;float mt05sum=0.;for(int mt05i=0;mt05i<18;mt05i++){float mt05s=float(mt05i)/17.;vec2 mt05d=.36*mt05s*vec2(cos(mt05s*9.+iTime*.2),sin(mt05s*7.));mt05sum+=exp(-4.*abs(mt05Field(mt05p+mt05d,iTime-mt05s)));}float mt05ink=1.-exp(-mt05sum*.16);vec3 mt05c=mix(uColBg,uColDim,.35);mt05c=mix(mt05c,uColSignal,mt05ink);mt05c+=uColPaper*.18*mt05ink+uColAccent*.12*sin(mt05sum);fragColor=vec4(mt05c,1.);}
