float mt09Field(vec2 p,float t){float shape=1.-smoothstep(.72,1.02,length(p*vec2(.85,1.)));float thickness=shape*(.62+.38*cos(p.x*2.));float z=sqrt(max(.01,1.-dot(p,p)));float back=max(0.,dot(normalize(vec3(p,z)),normalize(vec3(sin(t*.8),-.3,.35))));return thickness*.45+pow(back,2.)*(1.-thickness)*1.2+.18*sin(t*1.3+p.y*3.);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 mt09p=(fragCoord-.5*iResolution.xy)/iResolution.y*3.;vec2 mt09tile=floor(mt09p);vec2 mt09f=fract(mt09p)-.5;float mt09v=mt09Field(mt09f+mt09tile*.17,iTime+dot(mt09tile,vec2(.13,.19)));float mt09mark=smoothstep(.16,.01,abs(mt09v));float mt09edge=smoothstep(.49,.45,max(abs(mt09f.x),abs(mt09f.y)));vec3 mt09c=mix(uColBg,uColInk,mt09edge);mt09c=mix(mt09c,uColAccent,mt09mark);mt09c+=uColSignal*.22*(1.-mt09edge);mt09c=mix(mt09c,uColPaper,.16*(.5+.5*sin(iTime*2.1+mt09p.x*2.)));fragColor=vec4(mt09c,1.);}
