float mt10Hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7))+uSeed)*43758.5453);} float mt10Field(vec2 p,float t){vec2 cell=floor(p*18.),f=fract(p*18.)-.5;float h=mt10Hash(cell);float angle=h*6.28318;vec2 axis=vec2(cos(angle),sin(angle));float flake=smoothstep(.42,.08,max(abs(dot(f,axis)),abs(dot(f,vec2(-axis.y,axis.x)))*2.));float flash=pow(max(0.,cos(angle-t*.35)),12.);return flake*(.18+flash);}

void mainImage(out vec4 fragColor,in vec2 fragCoord){vec2 mt10p=(fragCoord-.5*iResolution.xy)/iResolution.y*2.5;float mt10layers=0.;for(int mt10k=0;mt10k<6;mt10k++){float mt10s=float(mt10k);vec2 mt10q=mt10p*(1.+mt10s*.13)+.08*vec2(sin(mt10s+iTime),cos(mt10s*.7-iTime));mt10layers+=sin(mt10Field(mt10q,iTime)*3.+mt10s);}float mt10v=.5+.5*sin(mt10layers);vec3 mt10c=mix(uColBg,uColPaper,mt10v*.55);mt10c=mix(mt10c,uColSignal,smoothstep(.65,.96,mt10v));mt10c=mix(mt10c,uColAccent,smoothstep(.92,1.,1.-mt10v));fragColor=vec4(mt10c,1.);}
